<Window
    x:Class="VibeWalkie.Companion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vibe Walkie">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
      <StackPanel Spacing="18" Padding="28" MaxWidth="760" HorizontalAlignment="Center">
        <TextBlock Text="Vibe Walkie" FontSize="34" FontWeight="SemiBold" />
        <TextBlock Text="Votre ordinateur sous la main, depuis votre iPhone" FontSize="16" Opacity="0.7" />
        <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational" Title="Démarrage…" />

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Coach de posture et marche" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="La caméra est analysée uniquement sur cet ordinateur. Aucune image n’est enregistrée ni transmise au réseau." TextWrapping="Wrap" />
            <ComboBox x:Name="CameraChoice" Header="Caméra" HorizontalAlignment="Stretch" />
            <Button Content="Actualiser les caméras" Click="RefreshCameras_Click" />
            <Image x:Name="CameraPreview" MaxHeight="320" Stretch="Uniform" />
            <TextBlock x:Name="PostureStatus" Text="Coach arrêté" TextWrapping="Wrap" />
            <ProgressBar x:Name="CalibrationProgress" Minimum="0" Maximum="1" />
            <ComboBox x:Name="SensitivityChoice" Header="Sensibilité" SelectedIndex="1" SelectionChanged="Sensitivity_Changed">
              <ComboBoxItem Content="Souple" Tag="relaxed" /><ComboBoxItem Content="Équilibrée" Tag="balanced" /><ComboBoxItem Content="Stricte" Tag="strict" />
            </ComboBox>
            <ToggleSwitch x:Name="SoundSwitch" Header="Alertes sonores de posture" IsOn="True" Toggled="Sound_Toggled" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Démarrer le coach" Click="StartPosture_Click" />
              <Button Content="Arrêter le coach" Click="StopPosture_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Enregistrer la bonne posture" Click="CalibratePosture_Click" />
              <Button Content="Apprendre la posture penchée" Click="CalibrateLean_Click" />
            </StackPanel>
            <TextBlock x:Name="HealthSummary" Text="Le résumé Santé apparaîtra après connexion et autorisation sur votre iPhone." TextWrapping="Wrap" />
            <Button Content="Actualiser le bilan" Click="RefreshHealth_Click" />
          </StackPanel>
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Commandes de l’iPhone" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Personnalisez les sept zones et la palette Global. Les modifications se synchronisent avec l’iPhone connecté." TextWrapping="Wrap" />
            <StackPanel x:Name="ControlsEditor" Spacing="8" />
            <TextBlock Text="Palette Global" FontWeight="SemiBold" />
            <StackPanel x:Name="GlobalEditor" Spacing="8" />
            <Button Content="Ajouter une commande Global" Click="AddGlobal_Click" />
            <Button Content="Appliquer les commandes" Click="ApplyControls_Click" />
          </StackPanel>
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Actions vocales" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Les commandes locales restent disponibles sans clé. Ajoutez une clé TypeSafe ou OpenRouter pour les actions avancées." TextWrapping="Wrap" />
            <PasswordBox x:Name="VoiceKey" Header="Clé du service de décision" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Vérifier et enregistrer" Click="SaveVoiceKey_Click" />
              <Button Content="Supprimer la clé" Click="RemoveVoiceKey_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Mises à jour" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="UpdateStatus" Text="Le canal Windows vérifie automatiquement les mises à jour à l’ouverture." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Rechercher une mise à jour" Click="CheckUpdate_Click" />
              <Button Content="Mettre à jour maintenant" Click="InstallUpdate_Click" />
            </StackPanel>
            <ToggleSwitch x:Name="StartupSwitch" Header="Ouvrir Vibe Walkie à la connexion Windows" Toggled="Startup_Toggled" />
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Associer un téléphone" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Scannez ce QR depuis Vibe Walkie. Le code de confirmation doit être identique sur les deux appareils." TextWrapping="Wrap" />
            <Image x:Name="PairingQr" Width="260" Height="260" Stretch="Uniform" />
            <TextBlock x:Name="ConfirmationCode" FontFamily="Consolas" FontSize="32" HorizontalAlignment="Center" />
            <Button x:Name="NewPairingButton" Content="Nouveau QR" Click="NewPairing_Click" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="Raccourcis de cet ordinateur" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Créez vos raccourcis et retrouvez-les dans les commandes de l’iPhone." TextWrapping="Wrap" Opacity="0.72" />
            <TextBox x:Name="ShortcutNameBox" Header="Nom affiché" PlaceholderText="Ex. Nouvelle note" />
            <TextBox x:Name="ShortcutKeyBox" Header="Combinaison" PlaceholderText="Cliquez puis tapez la combinaison" IsReadOnly="True" KeyDown="ShortcutKeyBox_KeyDown" />
            <Button Content="Enregistrer le raccourci" Click="SaveShortcut_Click" HorizontalAlignment="Left" />
            <ListView x:Name="ShortcutsList" SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}" />
                    <Button Grid.Column="1" Content="Supprimer" Tag="{Binding ID}" Click="RemoveShortcut_Click" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Demande en attente" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="PendingDevice" Text="Aucune" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="ApproveButton" Content="Autoriser" Click="Approve_Click" IsEnabled="False" />
              <Button x:Name="DenyButton" Content="Refuser" Click="Deny_Click" IsEnabled="False" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="Diagnostic local" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Relancer les tests" Click="RunDiagnostics_Click" />
              <Button Content="Copier le diagnostic expurgé" Click="CopyDiagnostics_Click" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="16" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Text="Téléphones autorisés" FontSize="22" FontWeight="SemiBold" />
            <ListView x:Name="ApprovedPeers" SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding DeviceName}" />
                      <TextBlock Text="{Binding ClientPlatform}" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Révoquer" Tag="{Binding ID}" Click="RevokePeer_Click" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Border>
        <Button Content="Quitter Vibe Walkie" Click="Quit_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
