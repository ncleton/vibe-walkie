            "value": "La imagen es ilegible o demasiado grande."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa ei voi lukea tai se on liian suuri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה אינה קריאה או גדולה מדי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज पढ़ी नहीं जा सकती या बहुत बड़ी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika je nečitljiva ili prevelika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép nem olvasható vagy túl nagy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tidak dapat dibaca atau terlalu besar."
          }
        },
