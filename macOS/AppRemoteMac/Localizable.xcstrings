            "state": "translated",
            "value": "所有 iPhone 都需要重新配对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 iPhone 都需要重新配對。"
          }
        },
        "fr": {
