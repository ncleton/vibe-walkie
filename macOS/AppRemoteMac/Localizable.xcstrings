    "mac.nomad.tutorial.mac.connect.details.8a01c91": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "1. افتح Tailscale على هذا الـ Mac.\n2. اختر تسجيل الدخول، ثم Apple أو Google أو Microsoft أو GitHub.\n3. اسمح بإضافة إعداد VPN الذي يطلبه macOS.\n4. اترك Tailscale مفعّلًا. لا حاجة لإعداد خادم أو منفذ." } },
        "ca": { "stringUnit": { "state": "translated", "value": "1. Obre Tailscale en aquest Mac.\n2. Tria Inicia sessió i després Apple, Google, Microsoft o GitHub.\n3. Autoritza la configuració VPN que demana macOS.\n4. Deixa Tailscale activat. No cal configurar cap servidor ni port." } },
        "cs": { "stringUnit": { "state": "translated", "value": "1. Otevřete Tailscale na tomto Macu.\n2. Zvolte Přihlásit se a poté Apple, Google, Microsoft nebo GitHub.\n3. Povolte konfiguraci VPN požadovanou systémem macOS.\n4. Nechte Tailscale zapnutý. Není třeba nastavovat server ani port." } },
        "da": { "stringUnit": { "state": "translated", "value": "1. Åbn Tailscale på denne Mac.\n2. Vælg Log ind og derefter Apple, Google, Microsoft eller GitHub.\n3. Tillad den VPN-konfiguration, som macOS beder om.\n4. Lad Tailscale være slået til. Du skal ikke konfigurere en server eller port." } },
        "de": { "stringUnit": { "state": "translated", "value": "1. Öffne Tailscale auf diesem Mac.\n2. Wähle Anmelden und dann Apple, Google, Microsoft oder GitHub.\n3. Erlaube die von macOS angeforderte VPN-Konfiguration.\n4. Lass Tailscale aktiviert. Server oder Ports müssen nicht eingerichtet werden." } },
        "el": { "stringUnit": { "state": "translated", "value": "1. Ανοίξτε το Tailscale σε αυτό το Mac.\n2. Επιλέξτε Σύνδεση και μετά Apple, Google, Microsoft ή GitHub.\n3. Επιτρέψτε τη διαμόρφωση VPN που ζητά το macOS.\n4. Αφήστε το Tailscale ενεργό. Δεν χρειάζεται ρύθμιση διακομιστή ή θύρας." } },
        "en": { "stringUnit": { "state": "translated", "value": "1. Open Tailscale on this Mac.\n2. Choose Sign in, then Apple, Google, Microsoft, or GitHub.\n3. Allow the VPN configuration requested by macOS.\n4. Leave Tailscale enabled. There is no server or port to configure." } },
        "es": { "stringUnit": { "state": "translated", "value": "1. Abre Tailscale en este Mac.\n2. Elige Iniciar sesión y luego Apple, Google, Microsoft o GitHub.\n3. Autoriza la configuración VPN solicitada por macOS.\n4. Deja Tailscale activado. No hay que configurar ningún servidor ni puerto." } },
        "fi": { "stringUnit": { "state": "translated", "value": "1. Avaa Tailscale tällä Macilla.\n2. Valitse Kirjaudu sisään ja sitten Apple, Google, Microsoft tai GitHub.\n3. Salli macOS:n pyytämä VPN-määritys.\n4. Jätä Tailscale käyttöön. Palvelinta tai porttia ei tarvitse määrittää." } },
        "fr": { "stringUnit": { "state": "translated", "value": "1. Ouvrez Tailscale sur ce Mac.\n2. Choisissez Se connecter, puis Apple, Google, Microsoft ou GitHub.\n3. Autorisez la configuration VPN demandée par macOS.\n4. Laissez Tailscale activé. Aucun serveur ni port n’est à configurer." } },
        "he": { "stringUnit": { "state": "translated", "value": "1. פתחו את Tailscale ב‑Mac הזה.\n2. בחרו התחברות ואז Apple, Google, Microsoft או GitHub.\n3. אשרו את תצורת ה‑VPN ש‑macOS מבקש.\n4. השאירו את Tailscale פעיל. אין צורך להגדיר שרת או יציאה." } },
        "hi": { "stringUnit": { "state": "translated", "value": "1. इस Mac पर Tailscale खोलें।\n2. साइन इन चुनें, फिर Apple, Google, Microsoft या GitHub चुनें।\n3. macOS द्वारा माँगी गई VPN कॉन्फ़िगरेशन की अनुमति दें।\n4. Tailscale चालू रखें। किसी सर्वर या पोर्ट को सेट करने की ज़रूरत नहीं है।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "1. Otvorite Tailscale na ovom Macu.\n2. Odaberite Prijava, zatim Apple, Google, Microsoft ili GitHub.\n3. Dopustite VPN konfiguraciju koju traži macOS.\n4. Ostavite Tailscale uključen. Nije potrebno postavljati poslužitelj ni port." } },
        "hu": { "stringUnit": { "state": "translated", "value": "1. Nyissa meg a Tailscale-t ezen a Macen.\n2. Válassza a Bejelentkezést, majd az Apple, Google, Microsoft vagy GitHub lehetőséget.\n3. Engedélyezze a macOS által kért VPN-konfigurációt.\n4. Hagyja bekapcsolva a Tailscale-t. Nem kell szervert vagy portot beállítani." } },
        "id": { "stringUnit": { "state": "translated", "value": "1. Buka Tailscale di Mac ini.\n2. Pilih Masuk, lalu Apple, Google, Microsoft, atau GitHub.\n3. Izinkan konfigurasi VPN yang diminta macOS.\n4. Biarkan Tailscale aktif. Tidak ada server atau port yang perlu diatur." } },
        "it": { "stringUnit": { "state": "translated", "value": "1. Apri Tailscale su questo Mac.\n2. Scegli Accedi, poi Apple, Google, Microsoft o GitHub.\n3. Consenti la configurazione VPN richiesta da macOS.\n4. Lascia Tailscale attivo. Non devi configurare server o porte." } },
        "ja": { "stringUnit": { "state": "translated", "value": "1. このMacでTailscaleを開きます。\n2. サインインを選び、Apple、Google、Microsoft、またはGitHubを選択します。\n3. macOSが求めるVPN構成を許可します。\n4. Tailscaleをオンのままにします。サーバーやポートの設定は不要です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "1. 이 Mac에서 Tailscale을 여세요.\n2. 로그인을 선택한 다음 Apple, Google, Microsoft 또는 GitHub를 선택하세요.\n3. macOS가 요청하는 VPN 구성을 허용하세요.\n4. Tailscale을 켜 두세요. 서버나 포트를 설정할 필요가 없습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "1. Buka Tailscale pada Mac ini.\n2. Pilih Log masuk, kemudian Apple, Google, Microsoft atau GitHub.\n3. Benarkan konfigurasi VPN yang diminta oleh macOS.\n4. Biarkan Tailscale aktif. Tiada pelayan atau port perlu dikonfigurasi." } },
        "nb": { "stringUnit": { "state": "translated", "value": "1. Åpne Tailscale på denne Macen.\n2. Velg Logg på og deretter Apple, Google, Microsoft eller GitHub.\n3. Tillat VPN-konfigurasjonen macOS ber om.\n4. La Tailscale være aktivert. Ingen server eller port må konfigureres." } },
        "nl": { "stringUnit": { "state": "translated", "value": "1. Open Tailscale op deze Mac.\n2. Kies Log in en daarna Apple, Google, Microsoft of GitHub.\n3. Sta de door macOS gevraagde VPN-configuratie toe.\n4. Laat Tailscale ingeschakeld. Je hoeft geen server of poort in te stellen." } },
        "pl": { "stringUnit": { "state": "translated", "value": "1. Otwórz Tailscale na tym Macu.\n2. Wybierz Zaloguj się, a następnie Apple, Google, Microsoft lub GitHub.\n3. Zezwól na konfigurację VPN wymaganą przez macOS.\n4. Pozostaw Tailscale włączony. Nie trzeba konfigurować serwera ani portu." } },
        "pt": { "stringUnit": { "state": "translated", "value": "1. Abra o Tailscale neste Mac.\n2. Escolha Iniciar sessão e depois Apple, Google, Microsoft ou GitHub.\n3. Autorize a configuração VPN pedida pelo macOS.\n4. Deixe o Tailscale ativo. Não é necessário configurar servidor nem porta." } },
        "ro": { "stringUnit": { "state": "translated", "value": "1. Deschideți Tailscale pe acest Mac.\n2. Alegeți Autentificare, apoi Apple, Google, Microsoft sau GitHub.\n3. Permiteți configurația VPN solicitată de macOS.\n4. Lăsați Tailscale activat. Nu trebuie configurat niciun server sau port." } },
        "ru": { "stringUnit": { "state": "translated", "value": "1. Откройте Tailscale на этом Mac.\n2. Выберите «Войти», затем Apple, Google, Microsoft или GitHub.\n3. Разрешите конфигурацию VPN, запрошенную macOS.\n4. Оставьте Tailscale включённым. Настраивать сервер или порт не нужно." } },
        "sk": { "stringUnit": { "state": "translated", "value": "1. Otvorte Tailscale na tomto Macu.\n2. Vyberte Prihlásiť sa a potom Apple, Google, Microsoft alebo GitHub.\n3. Povoľte konfiguráciu VPN požadovanú systémom macOS.\n4. Nechajte Tailscale zapnutý. Netreba nastavovať server ani port." } },
        "sv": { "stringUnit": { "state": "translated", "value": "1. Öppna Tailscale på denna Mac.\n2. Välj Logga in och sedan Apple, Google, Microsoft eller GitHub.\n3. Tillåt VPN-konfigurationen som macOS begär.\n4. Låt Tailscale vara aktiverat. Ingen server eller port behöver konfigureras." } },
        "th": { "stringUnit": { "state": "translated", "value": "1. เปิด Tailscale บน Mac เครื่องนี้\n2. เลือกลงชื่อเข้าใช้ แล้วเลือก Apple, Google, Microsoft หรือ GitHub\n3. อนุญาตการกำหนดค่า VPN ที่ macOS ขอ\n4. เปิด Tailscale ไว้ ไม่ต้องตั้งค่าเซิร์ฟเวอร์หรือพอร์ต" } },
        "tr": { "stringUnit": { "state": "translated", "value": "1. Bu Mac’te Tailscale’i açın.\n2. Giriş yap’ı, ardından Apple, Google, Microsoft veya GitHub’ı seçin.\n3. macOS’in istediği VPN yapılandırmasına izin verin.\n4. Tailscale’i açık bırakın. Sunucu veya bağlantı noktası ayarlamanız gerekmez." } },
        "uk": { "stringUnit": { "state": "translated", "value": "1. Відкрийте Tailscale на цьому Mac.\n2. Виберіть Увійти, потім Apple, Google, Microsoft або GitHub.\n3. Дозвольте конфігурацію VPN, яку запитує macOS.\n4. Залиште Tailscale увімкненим. Налаштовувати сервер чи порт не потрібно." } },
        "vi": { "stringUnit": { "state": "translated", "value": "1. Mở Tailscale trên máy Mac này.\n2. Chọn Đăng nhập, rồi chọn Apple, Google, Microsoft hoặc GitHub.\n3. Cho phép cấu hình VPN mà macOS yêu cầu.\n4. Giữ Tailscale bật. Bạn không cần cấu hình máy chủ hay cổng." } },
        "yue": { "stringUnit": { "state": "translated", "value": "1. 喺呢部 Mac 開啟 Tailscale。\n2. 揀登入，再揀 Apple、Google、Microsoft 或 GitHub。\n3. 允許 macOS 要求嘅 VPN 設定。\n4. 保持 Tailscale 開啟，唔使設定伺服器或連接埠。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "1. 在这台 Mac 上打开 Tailscale。\n2. 选择登录，然后选择 Apple、Google、Microsoft 或 GitHub。\n3. 允许 macOS 请求的 VPN 配置。\n4. 保持 Tailscale 开启，无需配置服务器或端口。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "1. 在這台 Mac 上開啟 Tailscale。\n2. 選擇登入，然後選擇 Apple、Google、Microsoft 或 GitHub。\n3. 允許 macOS 要求的 VPN 設定。\n4. 保持 Tailscale 開啟，無需設定伺服器或連接埠。" } }
      }
    },
    "mac.nomad.tutorial.iphone.details.2bcf5c1": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "1. امسح رمز QR بهاتف iPhone وثبّت Tailscale.\n2. افتح Tailscale واستخدم الحساب نفسه الموجود على الـ Mac.\n3. اضغط سماح لإضافة إعداد VPN.\n4. تأكد من أن Tailscale يعرض متصلًا." } },
        "ca": { "stringUnit": { "state": "translated", "value": "1. Escaneja el QR amb l’iPhone i instal·la Tailscale.\n2. Obre Tailscale i utilitza el mateix compte que al Mac.\n3. Toca Permet per afegir la configuració VPN.\n4. Comprova que Tailscale indiqui Connectat." } },
        "cs": { "stringUnit": { "state": "translated", "value": "1. Naskenujte QR iPhonem a nainstalujte Tailscale.\n2. Otevřete Tailscale a použijte stejný účet jako na Macu.\n3. Klepnutím na Povolit přidejte konfiguraci VPN.\n4. Ověřte, že Tailscale zobrazuje Připojeno." } },
        "da": { "stringUnit": { "state": "translated", "value": "1. Scan QR-koden med din iPhone, og installer Tailscale.\n2. Åbn Tailscale, og brug samme konto som på Mac.\n3. Tryk Tillad for at tilføje VPN-konfigurationen.\n4. Kontrollér, at Tailscale viser Forbundet." } },
        "de": { "stringUnit": { "state": "translated", "value": "1. Scanne den QR-Code mit dem iPhone und installiere Tailscale.\n2. Öffne Tailscale und verwende dasselbe Konto wie auf dem Mac.\n3. Tippe auf Erlauben, um die VPN-Konfiguration hinzuzufügen.\n4. Prüfe, ob Tailscale Verbunden anzeigt." } },
        "el": { "stringUnit": { "state": "translated", "value": "1. Σαρώστε το QR με το iPhone και εγκαταστήστε το Tailscale.\n2. Ανοίξτε το Tailscale και χρησιμοποιήστε τον ίδιο λογαριασμό με το Mac.\n3. Πατήστε Να επιτρέπεται για να προστεθεί η διαμόρφωση VPN.\n4. Βεβαιωθείτε ότι το Tailscale δείχνει Συνδεδεμένο." } },
        "en": { "stringUnit": { "state": "translated", "value": "1. Scan the QR code with your iPhone and install Tailscale.\n2. Open Tailscale and use the exact same account as on the Mac.\n3. Tap Allow to add the VPN configuration.\n4. Make sure Tailscale says Connected." } },
        "es": { "stringUnit": { "state": "translated", "value": "1. Escanea el QR con el iPhone e instala Tailscale.\n2. Abre Tailscale y usa exactamente la misma cuenta que en el Mac.\n3. Toca Permitir para añadir la configuración VPN.\n4. Comprueba que Tailscale indique Conectado." } },
        "fi": { "stringUnit": { "state": "translated", "value": "1. Skannaa QR-koodi iPhonella ja asenna Tailscale.\n2. Avaa Tailscale ja käytä täsmälleen samaa tiliä kuin Macilla.\n3. Lisää VPN-määritys napauttamalla Salli.\n4. Varmista, että Tailscale näyttää Yhdistetty." } },
        "fr": { "stringUnit": { "state": "translated", "value": "1. Scannez le QR avec l’iPhone et installez Tailscale.\n2. Ouvrez Tailscale et utilisez exactement le même compte que sur le Mac.\n3. Touchez Autoriser pour ajouter la configuration VPN.\n4. Vérifiez que Tailscale affiche Connecté." } },
        "he": { "stringUnit": { "state": "translated", "value": "1. סרקו את קוד ה‑QR עם ה‑iPhone והתקינו את Tailscale.\n2. פתחו את Tailscale והשתמשו בדיוק באותו חשבון כמו ב‑Mac.\n3. הקישו על אפשר כדי להוסיף את תצורת ה‑VPN.\n4. ודאו ש‑Tailscale מציג מחובר." } },
        "hi": { "stringUnit": { "state": "translated", "value": "1. iPhone से QR स्कैन करें और Tailscale इंस्टॉल करें।\n2. Tailscale खोलें और Mac वाला बिल्कुल वही खाता इस्तेमाल करें।\n3. VPN कॉन्फ़िगरेशन जोड़ने के लिए अनुमति दें टैप करें।\n4. सुनिश्चित करें कि Tailscale कनेक्टेड दिखाता है।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "1. Skenirajte QR iPhoneom i instalirajte Tailscale.\n2. Otvorite Tailscale i upotrijebite isti račun kao na Macu.\n3. Dodirnite Dopusti za dodavanje VPN konfiguracije.\n4. Provjerite prikazuje li Tailscale Povezano." } },
        "hu": { "stringUnit": { "state": "translated", "value": "1. Olvassa be a QR-kódot az iPhone-nal, és telepítse a Tailscale-t.\n2. Nyissa meg, és használja pontosan ugyanazt a fiókot, mint a Macen.\n3. Koppintson az Engedélyezésre a VPN-konfiguráció hozzáadásához.\n4. Ellenőrizze, hogy a Tailscale Kapcsolódva állapotot mutat." } },
        "id": { "stringUnit": { "state": "translated", "value": "1. Pindai QR dengan iPhone dan instal Tailscale.\n2. Buka Tailscale dan gunakan akun yang sama persis seperti di Mac.\n3. Ketuk Izinkan untuk menambahkan konfigurasi VPN.\n4. Pastikan Tailscale menampilkan Terhubung." } },
        "it": { "stringUnit": { "state": "translated", "value": "1. Scansiona il QR con l’iPhone e installa Tailscale.\n2. Apri Tailscale e usa esattamente lo stesso account del Mac.\n3. Tocca Consenti per aggiungere la configurazione VPN.\n4. Verifica che Tailscale indichi Connesso." } },
        "ja": { "stringUnit": { "state": "translated", "value": "1. iPhoneでQRコードを読み取り、Tailscaleをインストールします。\n2. Tailscaleを開き、Macとまったく同じアカウントを使います。\n3. 許可をタップしてVPN構成を追加します。\n4. Tailscaleに接続済みと表示されることを確認します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "1. iPhone으로 QR 코드를 스캔하고 Tailscale을 설치하세요.\n2. Tailscale을 열고 Mac과 정확히 같은 계정을 사용하세요.\n3. 허용을 탭하여 VPN 구성을 추가하세요.\n4. Tailscale에 연결됨이 표시되는지 확인하세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "1. Imbas QR dengan iPhone dan pasang Tailscale.\n2. Buka Tailscale dan gunakan akaun yang sama seperti pada Mac.\n3. Ketik Benarkan untuk menambah konfigurasi VPN.\n4. Pastikan Tailscale memaparkan Bersambung." } },
        "nb": { "stringUnit": { "state": "translated", "value": "1. Skann QR-koden med iPhone og installer Tailscale.\n2. Åpne Tailscale og bruk nøyaktig samme konto som på Macen.\n3. Trykk Tillat for å legge til VPN-konfigurasjonen.\n4. Kontroller at Tailscale viser Tilkoblet." } },
        "nl": { "stringUnit": { "state": "translated", "value": "1. Scan de QR-code met je iPhone en installeer Tailscale.\n2. Open Tailscale en gebruik exact hetzelfde account als op de Mac.\n3. Tik op Sta toe om de VPN-configuratie toe te voegen.\n4. Controleer of Tailscale Verbonden toont." } },
        "pl": { "stringUnit": { "state": "translated", "value": "1. Zeskanuj kod QR iPhonem i zainstaluj Tailscale.\n2. Otwórz Tailscale i użyj dokładnie tego samego konta co na Macu.\n3. Stuknij Zezwól, aby dodać konfigurację VPN.\n4. Sprawdź, czy Tailscale wyświetla Połączono." } },
        "pt": { "stringUnit": { "state": "translated", "value": "1. Leia o QR com o iPhone e instale o Tailscale.\n2. Abra o Tailscale e use exatamente a mesma conta do Mac.\n3. Toque em Permitir para adicionar a configuração VPN.\n4. Confirme que o Tailscale mostra Ligado." } },
        "ro": { "stringUnit": { "state": "translated", "value": "1. Scanați codul QR cu iPhone-ul și instalați Tailscale.\n2. Deschideți Tailscale și folosiți exact același cont ca pe Mac.\n3. Atingeți Permite pentru a adăuga configurația VPN.\n4. Verificați dacă Tailscale afișează Conectat." } },
        "ru": { "stringUnit": { "state": "translated", "value": "1. Отсканируйте QR-код на iPhone и установите Tailscale.\n2. Откройте Tailscale и используйте ту же учётную запись, что и на Mac.\n3. Нажмите «Разрешить», чтобы добавить конфигурацию VPN.\n4. Убедитесь, что Tailscale показывает «Подключено»." } },
        "sk": { "stringUnit": { "state": "translated", "value": "1. Naskenujte QR iPhonom a nainštalujte Tailscale.\n2. Otvorte Tailscale a použite presne ten istý účet ako na Macu.\n3. Klepnutím na Povoliť pridajte konfiguráciu VPN.\n4. Overte, že Tailscale zobrazuje Pripojené." } },
        "sv": { "stringUnit": { "state": "translated", "value": "1. Skanna QR-koden med iPhone och installera Tailscale.\n2. Öppna Tailscale och använd exakt samma konto som på Mac.\n3. Tryck på Tillåt för att lägga till VPN-konfigurationen.\n4. Kontrollera att Tailscale visar Ansluten." } },
        "th": { "stringUnit": { "state": "translated", "value": "1. สแกน QR ด้วย iPhone แล้วติดตั้ง Tailscale\n2. เปิด Tailscale และใช้บัญชีเดียวกับบน Mac\n3. แตะอนุญาตเพื่อเพิ่มการกำหนดค่า VPN\n4. ตรวจสอบว่า Tailscale แสดงว่าเชื่อมต่อแล้ว" } },
        "tr": { "stringUnit": { "state": "translated", "value": "1. QR kodunu iPhone ile tarayın ve Tailscale’i yükleyin.\n2. Tailscale’i açın ve Mac’teki hesabın aynısını kullanın.\n3. VPN yapılandırmasını eklemek için İzin ver’e dokunun.\n4. Tailscale’in Bağlı yazdığını doğrulayın." } },
        "uk": { "stringUnit": { "state": "translated", "value": "1. Відскануйте QR-код на iPhone та встановіть Tailscale.\n2. Відкрийте Tailscale і використайте той самий обліковий запис, що й на Mac.\n3. Натисніть Дозволити, щоб додати конфігурацію VPN.\n4. Переконайтеся, що Tailscale показує Підключено." } },
        "vi": { "stringUnit": { "state": "translated", "value": "1. Quét mã QR bằng iPhone và cài đặt Tailscale.\n2. Mở Tailscale và dùng đúng tài khoản đã dùng trên Mac.\n3. Chạm Cho phép để thêm cấu hình VPN.\n4. Đảm bảo Tailscale hiển thị Đã kết nối." } },
        "yue": { "stringUnit": { "state": "translated", "value": "1. 用 iPhone 掃描 QR 並安裝 Tailscale。\n2. 開啟 Tailscale，使用同 Mac 完全相同嘅帳戶。\n3. 撳允許加入 VPN 設定。\n4. 確認 Tailscale 顯示已連線。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "1. 用 iPhone 扫描二维码并安装 Tailscale。\n2. 打开 Tailscale，使用与 Mac 完全相同的账户。\n3. 轻点允许以添加 VPN 配置。\n4. 确认 Tailscale 显示已连接。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "1. 用 iPhone 掃描 QR 碼並安裝 Tailscale。\n2. 開啟 Tailscale，使用與 Mac 完全相同的帳戶。\n3. 點一下允許以加入 VPN 設定。\n4. 確認 Tailscale 顯示已連線。" } }
      }
    },
    "mac.nomad.tutorial.verify.details.94f40e2": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "افتح قائمة أجهزة Tailscale وتأكد من ظهور الـ Mac والـ iPhone تحت الحساب نفسه. إذا غاب أحدهما، سجّل الخروج منه ثم ادخل بالحساب المستخدم على الجهاز الآخر." } },
        "ca": { "stringUnit": { "state": "translated", "value": "Obre la llista de dispositius de Tailscale i comprova que el Mac i l’iPhone apareguin al mateix compte. Si en falta un, tanca-hi la sessió i entra amb el compte de l’altre dispositiu." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Otevřete seznam zařízení Tailscale a ověřte, že Mac i iPhone jsou pod stejným účtem. Pokud některé chybí, odhlaste ho a přihlaste účtem z druhého zařízení." } },
        "da": { "stringUnit": { "state": "translated", "value": "Åbn Tailscales enhedsliste, og kontrollér, at både Mac og iPhone vises under samme konto. Mangler den ene, skal du logge ud på den og bruge kontoen fra den anden enhed." } },
        "de": { "stringUnit": { "state": "translated", "value": "Öffne die Tailscale-Geräteliste und prüfe, ob Mac und iPhone unter demselben Konto erscheinen. Fehlt ein Gerät, melde es ab und mit dem Konto des anderen Geräts wieder an." } },
        "el": { "stringUnit": { "state": "translated", "value": "Ανοίξτε τη λίστα συσκευών Tailscale και βεβαιωθείτε ότι Mac και iPhone εμφανίζονται στον ίδιο λογαριασμό. Αν λείπει κάποιο, αποσυνδεθείτε από αυτό και χρησιμοποιήστε τον λογαριασμό της άλλης συσκευής." } },
        "en": { "stringUnit": { "state": "translated", "value": "Open the Tailscale device list and make sure both the Mac and iPhone appear under the same account. If one is missing, sign out on that device and use the account from the other one." } },
        "es": { "stringUnit": { "state": "translated", "value": "Abre la lista de dispositivos de Tailscale y comprueba que el Mac y el iPhone aparezcan en la misma cuenta. Si falta uno, cierra sesión en él y usa la cuenta del otro dispositivo." } },
        "fi": { "stringUnit": { "state": "translated", "value": "Avaa Tailscalen laiteluettelo ja varmista, että sekä Mac että iPhone näkyvät samalla tilillä. Jos toinen puuttuu, kirjaudu sillä ulos ja käytä toisen laitteen tiliä." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Ouvrez la liste des appareils Tailscale et vérifiez que le Mac et l’iPhone apparaissent sous le même compte. S’il en manque un, déconnectez-le puis reconnectez-le avec le compte utilisé sur l’autre appareil." } },
        "he": { "stringUnit": { "state": "translated", "value": "פתחו את רשימת המכשירים של Tailscale וודאו שה‑Mac וה‑iPhone מופיעים באותו חשבון. אם אחד חסר, התנתקו בו והתחברו עם החשבון של המכשיר האחר." } },
        "hi": { "stringUnit": { "state": "translated", "value": "Tailscale की डिवाइस सूची खोलें और सुनिश्चित करें कि Mac और iPhone एक ही खाते में दिखते हैं। यदि कोई नहीं दिखता, उस डिवाइस से साइन आउट करके दूसरे डिवाइस वाला खाता इस्तेमाल करें।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Otvorite Tailscaleov popis uređaja i provjerite pojavljuju li se Mac i iPhone pod istim računom. Ako jedan nedostaje, odjavite ga i prijavite računom s drugog uređaja." } },
        "hu": { "stringUnit": { "state": "translated", "value": "Nyissa meg a Tailscale eszközlistáját, és ellenőrizze, hogy a Mac és az iPhone ugyanazon fiók alatt jelenik-e meg. Ha valamelyik hiányzik, jelentkezzen ki rajta, majd használja a másik eszköz fiókját." } },
        "id": { "stringUnit": { "state": "translated", "value": "Buka daftar perangkat Tailscale dan pastikan Mac serta iPhone muncul di akun yang sama. Jika salah satunya tidak ada, keluar di perangkat itu lalu gunakan akun dari perangkat lainnya." } },
        "it": { "stringUnit": { "state": "translated", "value": "Apri l’elenco dispositivi di Tailscale e verifica che Mac e iPhone compaiano nello stesso account. Se ne manca uno, esci su quel dispositivo e usa l’account dell’altro." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Tailscaleのデバイス一覧を開き、MacとiPhoneが同じアカウントに表示されることを確認します。片方がない場合はその端末でサインアウトし、もう一方と同じアカウントを使います。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Tailscale 기기 목록을 열고 Mac과 iPhone이 같은 계정 아래 표시되는지 확인하세요. 하나가 없다면 해당 기기에서 로그아웃한 뒤 다른 기기의 계정으로 로그인하세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Buka senarai peranti Tailscale dan pastikan Mac serta iPhone muncul di bawah akaun yang sama. Jika satu tiada, log keluar pada peranti itu dan gunakan akaun peranti yang satu lagi." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Åpne Tailscales enhetsliste og kontroller at både Mac og iPhone vises under samme konto. Hvis én mangler, logger du ut på den og bruker kontoen fra den andre enheten." } },
        "nl": { "stringUnit": { "state": "translated", "value": "Open de apparatenlijst van Tailscale en controleer of Mac en iPhone onder hetzelfde account staan. Ontbreekt er één, log daar dan uit en gebruik het account van het andere apparaat." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Otwórz listę urządzeń Tailscale i sprawdź, czy Mac oraz iPhone są widoczne na tym samym koncie. Jeśli któregoś brakuje, wyloguj je i użyj konta z drugiego urządzenia." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Abra a lista de dispositivos do Tailscale e confirme que o Mac e o iPhone aparecem na mesma conta. Se faltar um, termine sessão nesse dispositivo e use a conta do outro." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Deschideți lista de dispozitive Tailscale și verificați dacă Mac-ul și iPhone-ul apar în același cont. Dacă lipsește unul, deconectați-l și folosiți contul de pe celălalt dispozitiv." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Откройте список устройств Tailscale и убедитесь, что Mac и iPhone находятся в одной учётной записи. Если одного нет, выйдите на нём и войдите с учётной записью другого устройства." } },
        "sk": { "stringUnit": { "state": "translated", "value": "Otvorte zoznam zariadení Tailscale a overte, že Mac aj iPhone sú v rovnakom účte. Ak niektoré chýba, odhláste ho a použite účet z druhého zariadenia." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Öppna Tailscales enhetslista och kontrollera att både Mac och iPhone visas under samma konto. Om en saknas loggar du ut på den och använder kontot från den andra enheten." } },
        "th": { "stringUnit": { "state": "translated", "value": "เปิดรายการอุปกรณ์ Tailscale และตรวจสอบว่า Mac กับ iPhone อยู่ในบัญชีเดียวกัน หากขาดเครื่องใดเครื่องหนึ่ง ให้ออกจากระบบบนเครื่องนั้นแล้วใช้บัญชีจากอีกเครื่อง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Tailscale cihaz listesini açın ve Mac ile iPhone’un aynı hesap altında göründüğünü doğrulayın. Biri eksikse o cihazdan çıkış yapıp diğer cihazdaki hesabı kullanın." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Відкрийте список пристроїв Tailscale і переконайтеся, що Mac та iPhone є в одному обліковому записі. Якщо одного немає, вийдіть на ньому та використайте обліковий запис іншого пристрою." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Mở danh sách thiết bị Tailscale và đảm bảo Mac cùng iPhone xuất hiện trong cùng một tài khoản. Nếu thiếu một thiết bị, hãy đăng xuất trên thiết bị đó rồi dùng tài khoản của thiết bị còn lại." } },
        "yue": { "stringUnit": { "state": "translated", "value": "開啟 Tailscale 裝置清單，確認 Mac 同 iPhone 顯示喺同一帳戶。如果少咗一部，就喺嗰部登出，再用另一部裝置嘅帳戶登入。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "打开 Tailscale 设备列表，确认 Mac 和 iPhone 显示在同一账户下。如果缺少一台，请在该设备上退出，然后使用另一台设备的账户登录。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "開啟 Tailscale 裝置列表，確認 Mac 和 iPhone 顯示在同一帳戶下。如果缺少一台，請在該裝置上登出，再使用另一台裝置的帳戶登入。" } }
      }
    },
    "mac.nomad.tutorial.iphone.confirmed.79ca12e": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "يظهر iPhone في Tailscale وهو متصل" } },
        "ca": { "stringUnit": { "state": "translated", "value": "L’iPhone apareix a Tailscale i està connectat" } },
        "cs": { "stringUnit": { "state": "translated", "value": "iPhone je v Tailscale viditelný a připojený" } },
        "da": { "stringUnit": { "state": "translated", "value": "Min iPhone vises i Tailscale og er forbundet" } },
        "de": { "stringUnit": { "state": "translated", "value": "Das iPhone wird in Tailscale angezeigt und ist verbunden" } },
        "el": { "stringUnit": { "state": "translated", "value": "Το iPhone εμφανίζεται στο Tailscale και είναι συνδεδεμένο" } },
        "en": { "stringUnit": { "state": "translated", "value": "My iPhone appears in Tailscale and is connected" } },
        "es": { "stringUnit": { "state": "translated", "value": "El iPhone aparece en Tailscale y está conectado" } },
        "fi": { "stringUnit": { "state": "translated", "value": "iPhone näkyy Tailscalessa ja on yhdistetty" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Mon iPhone apparaît dans Tailscale et il est connecté" } },
        "he": { "stringUnit": { "state": "translated", "value": "ה‑iPhone מופיע ב‑Tailscale ומחובר" } },
        "hi": { "stringUnit": { "state": "translated", "value": "मेरा iPhone Tailscale में दिखता है और कनेक्टेड है" } },
        "hr": { "stringUnit": { "state": "translated", "value": "iPhone se prikazuje u Tailscaleu i povezan je" } },
        "hu": { "stringUnit": { "state": "translated", "value": "Az iPhone megjelenik a Tailscale-ben és csatlakoztatva van" } },
        "id": { "stringUnit": { "state": "translated", "value": "iPhone saya muncul di Tailscale dan terhubung" } },
        "it": { "stringUnit": { "state": "translated", "value": "L’iPhone compare in Tailscale ed è connesso" } },
        "ja": { "stringUnit": { "state": "translated", "value": "iPhoneがTailscaleに表示され、接続済みです" } },
        "ko": { "stringUnit": { "state": "translated", "value": "iPhone이 Tailscale에 표시되고 연결되어 있습니다" } },
        "ms": { "stringUnit": { "state": "translated", "value": "iPhone saya muncul dalam Tailscale dan bersambung" } },
        "nb": { "stringUnit": { "state": "translated", "value": "iPhone vises i Tailscale og er tilkoblet" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Mijn iPhone staat in Tailscale en is verbonden" } },
        "pl": { "stringUnit": { "state": "translated", "value": "iPhone jest widoczny w Tailscale i połączony" } },
        "pt": { "stringUnit": { "state": "translated", "value": "O iPhone aparece no Tailscale e está ligado" } },
        "ro": { "stringUnit": { "state": "translated", "value": "iPhone-ul apare în Tailscale și este conectat" } },
        "ru": { "stringUnit": { "state": "translated", "value": "iPhone отображается в Tailscale и подключён" } },
        "sk": { "stringUnit": { "state": "translated", "value": "iPhone je v Tailscale viditeľný a pripojený" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Min iPhone visas i Tailscale och är ansluten" } },
        "th": { "stringUnit": { "state": "translated", "value": "iPhone ของฉันแสดงใน Tailscale และเชื่อมต่อแล้ว" } },
        "tr": { "stringUnit": { "state": "translated", "value": "iPhone’um Tailscale’de görünüyor ve bağlı" } },
        "uk": { "stringUnit": { "state": "translated", "value": "iPhone відображається в Tailscale і підключений" } },
        "vi": { "stringUnit": { "state": "translated", "value": "iPhone của tôi xuất hiện trong Tailscale và đã kết nối" } },
        "yue": { "stringUnit": { "state": "translated", "value": "我部 iPhone 已顯示喺 Tailscale 並已連線" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "我的 iPhone 已显示在 Tailscale 中并已连接" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "我的 iPhone 已顯示在 Tailscale 中並已連線" } }
      }
    },
    "mac.nomad.tutorial.activate.details.12a49ab": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "اكتشف Vibe Walkie شبكة Tailscale الخاصة بك. فعّل وضع الترحال، ثم أعد إقران iPhone كي يحفظ عنوان Mac الخاص. لا يشارك Vibe Walkie حساب Tailscale أو رمزه." } },
        "ca": { "stringUnit": { "state": "translated", "value": "Vibe Walkie ha detectat la teva xarxa privada Tailscale. Activa el Mode Nòmada i torna a aparellar l’iPhone perquè desi l’adreça privada del Mac. Vibe Walkie no rep el compte ni cap testimoni de Tailscale." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Vibe Walkie rozpoznal vaši soukromou síť Tailscale. Zapněte Režim na cestách a znovu spárujte iPhone, aby si uložil soukromou adresu Macu. Účet ani token Tailscale se Vibe Walkie nesdílí." } },
        "da": { "stringUnit": { "state": "translated", "value": "Vibe Walkie har fundet dit private Tailscale-netværk. Aktivér Nomadetilstand, og par iPhone igen, så den gemmer Macens private adresse. Vibe Walkie får hverken din Tailscale-konto eller token." } },
        "de": { "stringUnit": { "state": "translated", "value": "Vibe Walkie hat dein privates Tailscale-Netzwerk erkannt. Aktiviere den Nomadenmodus und kopple das iPhone erneut, damit es die private Mac-Adresse speichert. Konto und Token von Tailscale werden nicht an Vibe Walkie weitergegeben." } },
        "el": { "stringUnit": { "state": "translated", "value": "Το Vibe Walkie εντόπισε το ιδιωτικό δίκτυο Tailscale. Ενεργοποιήστε τη Λειτουργία Νομάδα και ζευγοποιήστε ξανά το iPhone ώστε να αποθηκεύσει την ιδιωτική διεύθυνση του Mac. Δεν κοινοποιείται λογαριασμός ή διακριτικό Tailscale." } },
        "en": { "stringUnit": { "state": "translated", "value": "Vibe Walkie detected your private Tailscale network. Enable Remote Mode, then pair the iPhone again so it saves the Mac’s private address. Your Tailscale account and token are never shared with Vibe Walkie." } },
        "es": { "stringUnit": { "state": "translated", "value": "Vibe Walkie ha detectado tu red privada de Tailscale. Activa el Modo Nómada y vuelve a enlazar el iPhone para que guarde la dirección privada del Mac. Vibe Walkie no recibe tu cuenta ni token de Tailscale." } },
        "fi": { "stringUnit": { "state": "translated", "value": "Vibe Walkie havaitsi yksityisen Tailscale-verkkosi. Ota etätila käyttöön ja muodosta iPhone-pari uudelleen, jotta Macin yksityinen osoite tallennetaan. Tailscale-tiliä tai tunnusta ei jaeta Vibe Walkielle." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie a détecté votre réseau privé Tailscale. Activez le Mode Nomade, puis appairez à nouveau l’iPhone pour qu’il mémorise l’adresse privée du Mac. Votre compte et votre jeton Tailscale ne sont jamais transmis à Vibe Walkie." } },
        "he": { "stringUnit": { "state": "translated", "value": "Vibe Walkie זיהה את רשת Tailscale הפרטית שלכם. הפעילו מצב נייד וצמדו שוב את ה‑iPhone כדי שישמור את הכתובת הפרטית של ה‑Mac. החשבון והאסימון של Tailscale לעולם אינם משותפים עם Vibe Walkie." } },
        "hi": { "stringUnit": { "state": "translated", "value": "Vibe Walkie ने आपका निजी Tailscale नेटवर्क पहचान लिया है। नोमैड मोड चालू करें, फिर iPhone को दोबारा पेयर करें ताकि वह Mac का निजी पता सहेज ले। आपका Tailscale खाता या टोकन Vibe Walkie से साझा नहीं होता।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie je otkrio vašu privatnu Tailscale mrežu. Uključite Nomadski način i ponovno uparite iPhone kako bi spremio privatnu adresu Maca. Račun i token Tailscalea ne dijele se s Vibe Walkiejem." } },
        "hu": { "stringUnit": { "state": "translated", "value": "A Vibe Walkie felismerte a privát Tailscale-hálózatot. Kapcsolja be a Nomád módot, majd párosítsa újra az iPhone-t, hogy elmentse a Mac privát címét. A Tailscale-fiók és token nem kerül a Vibe Walkie-hoz." } },
        "id": { "stringUnit": { "state": "translated", "value": "Vibe Walkie mendeteksi jaringan privat Tailscale Anda. Aktifkan Mode Nomaden, lalu pasangkan kembali iPhone agar menyimpan alamat privat Mac. Akun dan token Tailscale tidak pernah dibagikan ke Vibe Walkie." } },
        "it": { "stringUnit": { "state": "translated", "value": "Vibe Walkie ha rilevato la rete privata Tailscale. Attiva la Modalità Nomade e abbina di nuovo l’iPhone affinché salvi l’indirizzo privato del Mac. Account e token Tailscale non vengono mai condivisi con Vibe Walkie." } },
        "ja": { "stringUnit": { "state": "translated", "value": "Vibe WalkieがプライベートTailscaleネットワークを検出しました。ノマドモードを有効にし、iPhoneを再度ペアリングしてMacのプライベートアドレスを保存します。TailscaleのアカウントやトークンはVibe Walkieと共有されません。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "Vibe Walkie가 비공개 Tailscale 네트워크를 감지했습니다. 노마드 모드를 켠 다음 iPhone을 다시 페어링하여 Mac의 비공개 주소를 저장하세요. Tailscale 계정과 토큰은 Vibe Walkie와 공유되지 않습니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Vibe Walkie mengesan rangkaian peribadi Tailscale anda. Aktifkan Mod Nomad dan pasangkan semula iPhone supaya alamat peribadi Mac disimpan. Akaun dan token Tailscale tidak pernah dikongsi dengan Vibe Walkie." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Vibe Walkie har funnet det private Tailscale-nettverket ditt. Aktiver Nomademodus og par iPhone på nytt slik at Macens private adresse lagres. Tailscale-konto og token deles aldri med Vibe Walkie." } },
        "nl": { "stringUnit": { "state": "translated", "value": "Vibe Walkie heeft je privé-Tailscale-netwerk gevonden. Schakel Nomadenmodus in en koppel de iPhone opnieuw zodat het privéadres van de Mac wordt opgeslagen. Je Tailscale-account en token worden nooit met Vibe Walkie gedeeld." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Vibe Walkie wykrył prywatną sieć Tailscale. Włącz Tryb Nomady i ponownie sparuj iPhone’a, aby zapisał prywatny adres Maca. Konto ani token Tailscale nigdy nie są udostępniane Vibe Walkie." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O Vibe Walkie detetou a sua rede privada Tailscale. Ative o Modo Nómada e volte a emparelhar o iPhone para guardar o endereço privado do Mac. A conta e o token Tailscale nunca são partilhados com o Vibe Walkie." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Vibe Walkie a detectat rețeaua privată Tailscale. Activați Modul Nomad și asociați din nou iPhone-ul pentru a salva adresa privată a Mac-ului. Contul și tokenul Tailscale nu sunt partajate cu Vibe Walkie." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Vibe Walkie обнаружил вашу частную сеть Tailscale. Включите режим «Кочевник» и снова выполните сопряжение iPhone, чтобы сохранить частный адрес Mac. Учётная запись и токен Tailscale не передаются Vibe Walkie." } },
        "sk": { "stringUnit": { "state": "translated", "value": "Vibe Walkie rozpoznal vašu súkromnú sieť Tailscale. Zapnite Nomádsky režim a znova spárujte iPhone, aby si uložil súkromnú adresu Macu. Účet ani token Tailscale sa s Vibe Walkie nezdieľajú." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Vibe Walkie har hittat ditt privata Tailscale-nätverk. Aktivera Nomadläge och parkoppla iPhone igen så att Macens privata adress sparas. Tailscale-konto och token delas aldrig med Vibe Walkie." } },
        "th": { "stringUnit": { "state": "translated", "value": "Vibe Walkie ตรวจพบเครือข่าย Tailscale ส่วนตัวของคุณแล้ว เปิดโหมด Nomad แล้วจับคู่ iPhone อีกครั้งเพื่อบันทึกที่อยู่ส่วนตัวของ Mac บัญชีและโทเค็น Tailscale จะไม่ถูกส่งให้ Vibe Walkie" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie özel Tailscale ağınızı algıladı. Göçebe Modu’nu açın ve Mac’in özel adresini kaydetmesi için iPhone’u yeniden eşleyin. Tailscale hesabınız ve belirteciniz Vibe Walkie ile paylaşılmaz." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Vibe Walkie виявив вашу приватну мережу Tailscale. Увімкніть Режим Кочівника й повторно спаріть iPhone, щоб зберегти приватну адресу Mac. Обліковий запис і токен Tailscale не передаються Vibe Walkie." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Vibe Walkie đã phát hiện mạng Tailscale riêng của bạn. Bật Chế độ Du mục rồi ghép đôi lại iPhone để lưu địa chỉ riêng của Mac. Tài khoản và token Tailscale không bao giờ được chia sẻ với Vibe Walkie." } },
        "yue": { "stringUnit": { "state": "translated", "value": "Vibe Walkie 已偵測到你嘅私人 Tailscale 網絡。開啟遊牧模式，再重新配對 iPhone，等佢記住 Mac 嘅私人地址。Tailscale 帳戶同權杖永遠唔會交畀 Vibe Walkie。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Vibe Walkie 已检测到您的私人 Tailscale 网络。启用游牧模式，然后重新配对 iPhone，使其保存 Mac 的私人地址。您的 Tailscale 账户和令牌绝不会与 Vibe Walkie 共享。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "Vibe Walkie 已偵測到您的私人 Tailscale 網路。啟用遊牧模式，然後重新配對 iPhone，使其儲存 Mac 的私人位址。您的 Tailscale 帳戶和權杖絕不會與 Vibe Walkie 分享。" } }
      }
    }
  },
  "version": "1.0"
}
