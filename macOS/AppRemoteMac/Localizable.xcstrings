    "mac.the.image.is.unreadable.or.too.large.17ebb3d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is unreadable or too large."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist unlesbar oder zu groß."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة غير مقروءة أو كبيرة جداً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La imatge és il·legible o massa gran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet kan ikke læses eller er for stort."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek je nečitelný nebo příliš velký."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα δεν είναι αναγνώσιμη ή είναι πολύ μεγάλη."
          }
        },
        "es": {
          "stringUnit": {
