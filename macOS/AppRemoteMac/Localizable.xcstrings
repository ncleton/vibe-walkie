    "mac.pointer.keyboard.and.screen.control.will.be.granted.only.after.fd007ac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer, keyboard, and screen control will be granted only after you confirm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger-, Tastatur- und Bildschirmsteuerung werden erst nach deiner Bestätigung erlaubt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُسمح بالتحكم في المؤشر ولوحة المفاتيح والشاشة إلا بعد التأكيد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El control del punter, el teclat i la pantalla només es permetrà després de confirmar-ho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styring af markør, tastatur og skærm tillades først, når du bekræfter."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládání ukazatele, klávesnice a obrazovky bude povoleno až po potvrzení."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο έλεγχος του δείκτη, του πληκτρολογίου και της οθόνης θα επιτραπεί μόνο μετά την επιβεβαίωσή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control del puntero, el teclado y la pantalla solo se permitirá cuando confirmes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoittimen, näppäimistön ja näytön ohjaus sallitaan vasta vahvistuksen jälkeen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השליטה במצביע, במקלדת ובמסך תתאפשר רק לאחר אישורכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करने के बाद ही पॉइंटर, कीबोर्ड और स्क्रीन कंट्रोल की अनुमति मिलेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljanje pokazivačem, tipkovnicom i zaslonom omogućit će se tek nakon vaše potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mutató, a billentyűzet és a képernyő vezérlése csak a megerősítésed után lesz engedélyezve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol penunjuk, papan ketik, dan layar hanya akan diberikan setelah Anda mengonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il puntatore, la tastiera e il controllo dello schermo saranno concessi solo dopo la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後にのみ、ポインタ、キーボード、画面の操作が許可されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 후에만 포인터, 키보드, 화면 제어가 허용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawalan penuding, papan kekunci dan skrin hanya akan diberikan selepas anda mengesahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styring av peker, tastatur og skjerm tillates først etter at du bekrefter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bediening van aanwijzer, toetsenbord en scherm wordt pas toegestaan nadat je dit bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaźnik, klawiatura i sterowanie ekranem zostaną udostępnione dopiero po potwierdzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponteiro, o teclado e o controle da tela só serão concedidos após a confirmação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlul cursorului, tastaturii și ecranului va fi acordat numai după confirmare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление указателем, клавиатурой и экраном будет разрешено только после подтверждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládanie ukazovateľa, klávesnice a obrazovky bude povolené až po vašom potvrdení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrning av pekare, tangentbord och skärm tillåts först när du bekräftar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะอนุญาตการควบคุมตัวชี้ แป้นพิมพ์ และหน้าจอหลังจากคุณยืนยันเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçi, klavye ve ekran kontrolü yalnızca onayınızdan sonra verilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керування вказівником, клавіатурою та екраном буде дозволено лише після вашого підтвердження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền điều khiển con trỏ, bàn phím và màn hình chỉ được cấp sau khi bạn xác nhận."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "你確認之後，先會授予游標、鍵盤同螢幕控制權。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你确认后，才会授予指针、键盘和屏幕控制权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你確認後，才會授予指標、鍵盤和螢幕控制權限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle du pointeur, du clavier et de l’écran ne sera accordé qu’après votre confirmation."
          }
        }
      }
    },
