    "mac.allow.screen.recording.on.the.mac.then.relaunch.vibe.walkie.634232c": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Screen Recording on the Mac. Vibe Walkie detects the change automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Bildschirmaufnahme auf dem Mac. Vibe Walkie erkennt die Änderung automatisch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بتسجيل الشاشة على Mac. يكتشف Vibe Walkie التغيير تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet la Gravació de pantalla al Mac. Vibe Walkie detecta el canvi automàticament."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Skærmoptagelse på Mac. Vibe Walkie registrerer ændringen automatisk."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Záznam obrazovky na Macu. Vibe Walkie změnu rozpozná automaticky."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε την Εγγραφή οθόνης στο Mac. Το Vibe Walkie εντοπίζει αυτόματα την αλλαγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la grabación de pantalla en el Mac. Vibe Walkie detecta el cambio automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli näytön tallennus Macissa. Vibe Walkie tunnistaa muutoksen automaattisesti."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו הקלטת מסך ב‑Mac. ‏Vibe Walkie יזהה את השינוי באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac पर स्क्रीन रिकॉर्डिंग की अनुमति दें। Vibe Walkie बदलाव को अपने आप पहचान लेता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite Snimanje zaslona na Macu. Vibe Walkie automatski prepoznaje promjenu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Képernyőfelvételt a Macen. A Vibe Walkie automatikusan észleli a változást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Perekaman Layar di Mac. Vibe Walkie mendeteksi perubahan secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Registrazione schermo sul Mac. Vibe Walkie rileva automaticamente la modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで画面収録を許可してください。Vibe Walkieが変更を自動的に検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 화면 기록을 허용하세요. Vibe Walkie가 변경 사항을 자동으로 감지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Rakaman Skrin pada Mac. Vibe Walkie mengesan perubahan secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Skjermopptak på Macen. Vibe Walkie oppdager endringen automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Schermopname toe op de Mac. Vibe Walkie detecteert de wijziging automatisch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na nagrywanie ekranu na Macu. Vibe Walkie automatycznie wykryje zmianę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a Gravação de Tela no Mac. O Vibe Walkie detecta a alteração automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Înregistrarea ecranului pe Mac. Vibe Walkie detectează automat modificarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите запись экрана на Mac. Vibe Walkie автоматически обнаружит изменение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte Záznam obrazovky na Macu. Vibe Walkie zmenu rozpozná automaticky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Skärminspelning på Mac. Vibe Walkie upptäcker ändringen automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตการบันทึกหน้าจอบน Mac แล้ว Vibe Walkie จะตรวจพบการเปลี่ยนแปลงโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te Ekran Kaydı izni verin. Vibe Walkie değişikliği otomatik olarak algılar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте запис екрана на Mac. Vibe Walkie автоматично виявить зміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Ghi màn hình trên Mac. Vibe Walkie tự động phát hiện thay đổi."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "請喺 Mac 允許螢幕錄製。Vibe Walkie 會自動偵測變更。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Mac 上允许屏幕录制。Vibe Walkie 会自动检测更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Mac 上允許螢幕錄製。Vibe Walkie 會自動偵測變更。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’enregistrement de l’écran sur le Mac. Vibe Walkie détecte automatiquement le changement."
          }
        }
      }
    },
