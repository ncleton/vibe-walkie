    "mac.install.the.official.app.connect.this.mac.to.your.tailnet.e0ccba5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the official app, connect this Mac to your tailnet, then check again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die offizielle Tailscale-App, verbinde diesen Mac mit deinem Tailnet und prüfe erneut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت التطبيق الرسمي، وصِل جهاز Mac هذا بشبكة tailnet الخاصة بك، ثم تحقق مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·la l’app oficial, connecta aquest Mac al teu tailnet i torna a comprovar-ho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer den officielle app, forbind denne Mac til dit tailnet, og kontroller igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainstalujte oficiální aplikaci, připojte tento Mac ke svému tailnetu a zkontrolujte stav znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκαταστήστε την επίσημη εφαρμογή, συνδέστε αυτό το Mac στο tailnet σας και ελέγξτε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la app oficial de Tailscale, conecta este Mac a tu tailnet y vuelve a comprobarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asenna virallinen appi, yhdistä tämä Mac tailnet-verkkoosi ja tarkista uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקינו את היישום הרשמי, חברו את ה‑Mac הזה ל‑tailnet שלכם ואז בדקו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आधिकारिक ऐप इंस्टॉल करें, इस Mac को अपने tailnet से जोड़ें और फिर जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirajte službenu aplikaciju, povežite ovaj Mac sa svojim tailnetom, zatim ponovno provjerite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítsd a hivatalos alkalmazást, csatlakoztasd ezt a Macet a tailnetedhez, majd ellenőrizd újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal app resmi, hubungkan Mac ini ke tailnet Anda, lalu periksa kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa l’app ufficiale di Tailscale, collega questo Mac alla tua tailnet e verifica di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式アプリをインストールし、このMacをtailnetに接続してから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 앱을 설치하고 이 Mac을 tailnet에 연결한 다음 다시 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang aplikasi rasmi, sambungkan Mac ini ke tailnet anda, kemudian periksa semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer den offisielle appen, koble denne Macen til tailnettet ditt, og kontroller på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer de officiële app, verbind deze Mac met je tailnet en controleer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluj oficjalną aplikację Tailscale, połącz tego Maca ze swoim tailnetem i sprawdź ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a app oficial do Tailscale, ligue este Mac à sua tailnet e verifique novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalează aplicația oficială, conectează acest Mac la tailnet, apoi verifică din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите официальное приложение, подключите этот Mac к своей сети tailnet и проверьте снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nainštalujte oficiálnu aplikáciu, pripojte tento Mac k svojmu tailnetu a potom stav znova skontrolujte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera den officiella appen, anslut denna Mac till ditt tailnet och kontrollera igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแอปอย่างเป็นทางการ เชื่อมต่อ Mac เครื่องนี้กับ tailnet ของคุณ แล้วตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resmî Tailscale uygulamasını yükleyin, bu Mac’i tailnet’inize bağlayın ve yeniden denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть офіційну програму, підключіть цей Mac до своєї мережі tailnet і перевірте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt ứng dụng Tailscale chính thức, kết nối Mac này với tailnet của bạn rồi kiểm tra lại."
