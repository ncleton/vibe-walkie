    "mac.all.iphones.will.need.to.be.paired.again.ed49b37": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All iPhones will need to be paired again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle iPhones müssen wieder gekoppelt werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب إعادة إقران جميع أجهزة iPhone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Caldrà tornar a enllaçar tots els iPhones."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle iPhone-enheder skal parres igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny iPhony bude nutné znovu spárovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα iPhone θα πρέπει να συζευχθούν ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los iPhone tendrán que volver a emparejarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikista iPhoneista on muodostettava laitepari uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יהיה צורך לקשר מחדש את כל מכשירי ה‑iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी iPhone फिर से पेयर करने होंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve iPhone uređaje trebat će ponovno upariti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden iPhone-t újra kell párosítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua iPhone harus dipasangkan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli iPhone dovranno essere abbinati di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのiPhoneをもう一度ペアリングする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 iPhone을 다시 페어링해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua iPhone perlu dipasangkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle iPhone-enheter må kobles sammen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle iPhones moeten opnieuw worden gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie iPhone'y będą musiały być ponownie sparowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os iPhones terão de ser emparejados novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate iPhone-urile vor trebui asociate din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все iPhone потребуется связать заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky iPhony bude potrebné znova spárovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla iPhone-enheter måste parkopplas igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องจับคู่ iPhone ทุกเครื่องอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm iPhone'ların yeniden eşleştirilmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі iPhone потрібно буде спарити знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả iPhone sẽ cần được ghép đôi lại."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 iPhone 都要重新配對。"
          }
        },
        "zh-Hans": {
