    "mac.custom.keyboard.shortcuts.and.icons.will.be.replaced.76dd7e5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom keyboard shortcuts and icons will be replaced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Tastaturkurzbefehle und Symbole werden ersetzt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استبدال اختصارات لوحة المفاتيح والأيقونات المخصصة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dreceres de teclat i les icones personalitzades se substituiran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede tastaturgenveje og ikoner bliver erstattet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní klávesové zkratky a ikony budou nahrazeny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένες συντομεύσεις πληκτρολογίου και τα εικονίδια θα αντικατασταθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazarán los atajos de teclado personalizados e iconos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetut näppäimistön pikakomennot ja kuvakkeet korvataan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי מקלדת וסמלים מותאמים אישית יוחלפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम कीबोर्ड शॉर्टकट और आइकन बदल दिए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagođeni tipkovni prečaci i ikone bit će zamijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyéni billentyűparancsok és ikonok lecserélődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan papan ketik dan ikon khusus akan diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie e le icone personalizzate della tastiera saranno sostituite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムキーボードショートカットとアイコンは置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 설정 키보드 단축키와 아이콘이 교체됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan papan kekunci dan ikon tersuai akan digantikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede tastatursnarveier og ikoner blir erstattet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste sneltoetsen en pictogrammen worden vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe skróty klawiaturowe i ikony zostaną zastąpione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos e ícones do teclado personalizados serão substituídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurtăturile de tastatură și pictogramele personalizate vor fi înlocuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские сочетания клавиш и значки будут заменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné klávesové skratky a ikony budú nahradené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade kortkommandon och ikoner kommer att ersättas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดและไอคอนแบบกำหนดเองจะถูกแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel klavye kısayolları ve simgeler değiştirilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власні клавіатурні команди та значки буде замінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt bàn phím và biểu tượng tùy chỉnh sẽ bị thay thế."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂鍵盤快捷鍵同圖示將會被取代。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义键盘快捷键和图标将被替换。"
          }
        },
        "zh-Hant": {
