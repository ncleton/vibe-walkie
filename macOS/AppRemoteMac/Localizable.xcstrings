    "mac.the.app.was.opened.from.the.installation.disk.drag.it.015b0ae": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was opened from the installation disk. Drag it to the Applications shortcut, then open the installed copy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde vom Installationsvolume geöffnet. Ziehe sie auf den Kurzbefehl „Programme“ und öffne anschließend die installierte Kopie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فُتح التطبيق من قرص التثبيت. اسحبه إلى اختصار «التطبيقات»، ثم افتح النسخة المثبّتة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app s’ha obert des del disc d’instal·lació. Arrossega-la a la drecera Aplicacions i obre la còpia instal·lada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen blev åbnet fra installationsdisken. Træk den til genvejen Programmer, og åbn derefter den installerede kopi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace byla otevřena z instalačního disku. Přetáhněte ji na zástupce Aplikace a potom otevřete nainstalovanou kopii."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή άνοιξε από τον δίσκο εγκατάστασης. Σύρετέ την στη συντόμευση Εφαρμογές και ανοίξτε το εγκατεστημένο αντίγραφο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ha abierto desde el disco de instalación. Arrástrala al acceso directo Aplicaciones y abre la copia instalada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appi avattiin asennuslevyltä. Vedä se Ohjelmat-oikotiehen ja avaa sitten asennettu kopio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום נפתח מדיסק ההתקנה. גררו אותו לקיצור Applications ואז פתחו את העותק המותקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप इंस्टॉलेशन डिस्क से खोला गया है। इसे “Applications” शॉर्टकट पर खींचें, फिर इंस्टॉल की गई कॉपी खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija je otvorena s instalacijskog diska. Povucite je na prečac Aplikacije, zatim otvorite instaliranu kopiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazást a telepítőlemezről nyitottad meg. Húzd az Alkalmazások parancsikonjára, majd nyisd meg a telepített példányt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App dibuka dari disk instalasi. Seret ke pintasan Aplikasi, lalu buka salinan yang telah diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app è stata aperta dal disco di installazione. Trascinala nel collegamento Applicazioni, poi apri la copia installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはインストールディスクから開かれています。「アプリケーション」ショートカットへドラッグしてから、インストールしたアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 설치 디스크에서 열렸습니다. 응용 프로그램 바로가기로 드래그한 다음 설치된 앱을 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi dibuka daripada cakera pemasangan. Seret aplikasi ke pintasan Applications, kemudian buka salinan yang dipasang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen ble åpnet fra installeringsdisken. Dra den til snarveien Programmer, og åpne deretter den installerte kopien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app is vanaf de installatieschijf geopend. Sleep hem naar de snelkoppeling Apps en open vervolgens de geïnstalleerde kopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikację otwarto z dysku instalacyjnego. Przeciągnij ją do skrótu Aplikacje, a następnie otwórz zainstalowaną kopię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O app foi aberto pelo disco de instalação. Arraste-o para o atalho Aplicativos e abra a cópia instalada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația a fost deschisă de pe discul de instalare. Trage-o pe scurtătura Aplicații, apoi deschide copia instalată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение открыто с установочного диска. Перетащите его на ярлык «Программы», затем откройте установленную копию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácia bola otvorená z inštalačného disku. Potiahnite ju na skratku Aplikácie a potom otvorte nainštalovanú kópiu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen öppnades från installationsskivan. Dra den till genvägen Program och öppna sedan den installerade kopian."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปถูกเปิดจากดิสก์ติดตั้ง โปรดลากไปยังทางลัดแอปพลิเคชัน แล้วเปิดสำเนาที่ติดตั้งไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kurulum diskinden açıldı. Uygulamalar kısayoluna sürükleyin, ardından yüklenen kopyayı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програму відкрито з інсталяційного диска. Перетягніть її на ярлик «Програми», а потім відкрийте встановлену копію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng được mở từ đĩa cài đặt. Hãy kéo vào lối tắt Applications, sau đó mở bản đã cài."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "App 由安裝磁碟開啟。請將佢拖到「應用程式」捷徑，再開啟已安裝嘅版本。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 从安装磁盘中打开。请将它拖到“应用程序”快捷方式，然后打开已安装的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 從安裝磁碟中開啟。請將它拖到「應用程式」捷徑，然後開啟已安裝的副本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a été ouverte depuis le disque d’installation. Glissez-la vers le raccourci Applications, puis ouvrez la copie installée."
          }
        }
      }
    },
    "mac.the.field.captures.the.next.key.combination.8036479": {
      "localizations": {
