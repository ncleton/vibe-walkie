    "mac.tailscale.directly.connects.this.iphone.and.mac.vibe.walkie.keeps.1572430": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale directly connects this iPhone and Mac. Vibe Walkie keeps its own TLS encryption and pairing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale verbindet dieses iPhone und den Mac direkt. Vibe Walkie behält seine eigene TLS-Verschlüsselung und Kopplung bei."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يربط Tailscale هذا الـ iPhone بجهاز Mac مباشرةً. ويستخدم Vibe Walkie تشفير TLS الخاص به وإقران الأجهزة الآمن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale connecta directament aquest iPhone i el Mac. Vibe Walkie manté el seu propi xifratge TLS i l’enllaç."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale forbinder denne iPhone og Mac direkte. Vibe Walkie beholder sin egen TLS-kryptering og parring."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale přímo propojí tento iPhone a Mac. Vibe Walkie zachovává vlastní šifrování TLS a párování."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Tailscale συνδέει απευθείας αυτό το iPhone και το Mac. Το Vibe Walkie διατηρεί τη δική του κρυπτογράφηση TLS και σύζευξη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale conecta directamente este iPhone y el Mac. Vibe Walkie mantiene su propio cifrado TLS y emparejamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale yhdistää tämän iPhonen ja Macin suoraan. Vibe Walkie säilyttää oman TLS-salauksensa ja laiteparinsa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale מחבר ישירות את ה‑iPhone הזה ואת ה‑Mac. Vibe Walkie שומר על הצפנת TLS ועל קישור משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale इस iPhone और Mac को सीधे जोड़ता है। Vibe Walkie अपना TLS एन्क्रिप्शन और सुरक्षित डिवाइस पेयरिंग बनाए रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale izravno povezuje ovaj iPhone i Mac. Vibe Walkie zadržava vlastitu TLS enkripciju i uparivanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Tailscale közvetlenül összeköti ezt az iPhone-t és Macet. A Vibe Walkie megtartja saját TLS-titkosítását és párosítását."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale menghubungkan iPhone ini dan Mac secara langsung. Vibe Walkie tetap menggunakan enkripsi TLS dan pemasangannya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale collega direttamente questo iPhone e il Mac. Vibe Walkie mantiene la propria crittografia TLS e il proprio abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TailscaleはこのiPhoneとMacを直接接続します。Vibe Walkie独自のTLS暗号化とペアリングも引き続き使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale은 이 iPhone과 Mac을 직접 연결합니다. Vibe Walkie의 자체 TLS 암호화와 페어링도 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale menyambungkan iPhone ini terus ke Mac. Vibe Walkie mengekalkan penyulitan TLS dan pemasangannya sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale kobler denne iPhonen og Macen direkte sammen. Vibe Walkie beholder sin egen TLS-kryptering og sammenkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale verbindt deze iPhone en Mac rechtstreeks. Vibe Walkie behoudt de eigen TLS-versleuteling en koppeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale łączy tego iPhone’a i Maca bezpośrednio. Vibe Walkie zachowuje własne szyfrowanie TLS i parowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscale conecta diretamente este iPhone e o Mac. O Vibe Walkie mantém sua própria criptografia TLS e seu próprio emparelhamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale conectează direct acest iPhone și Mac. Vibe Walkie își păstrează propria criptare TLS și asociere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale напрямую соединяет этот iPhone с Mac. При этом Vibe Walkie использует собственное TLS-шифрование и защищённую связь устройств."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale priamo prepojí tento iPhone a Mac. Vibe Walkie si zachováva vlastné šifrovanie TLS a párovanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ansluter denna iPhone och Mac direkt. Vibe Walkie behåller sin egen TLS-kryptering och parkoppling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale เชื่อมต่อ iPhone กับ Mac เครื่องนี้โดยตรง ส่วน Vibe Walkie ยังคงใช้การเข้ารหัส TLS และการจับคู่ของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale bu iPhone ile Mac’i doğrudan bağlar. Vibe Walkie kendi TLS şifrelemesini ve eşleştirmesini korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale безпосередньо з’єднує цей iPhone і Mac. Vibe Walkie зберігає власне шифрування TLS і спарювання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale kết nối trực tiếp iPhone này với Mac. Vibe Walkie vẫn dùng mã hóa TLS và cơ chế ghép đôi riêng."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 會直接連接呢部 iPhone 同 Mac。Vibe Walkie 仍然保留自己嘅 TLS 加密同配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 直接连接这台 iPhone 与 Mac。Vibe Walkie 仍使用自己的 TLS 加密和配对机制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 會將這台 iPhone 與 Mac 直接連線。Vibe Walkie 仍使用自己的 TLS 加密和配對機制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale relie directement cet iPhone et ce Mac. Vibe Walkie conserve son propre chiffrement TLS et son appairage."
          }
        }
      }
    },
