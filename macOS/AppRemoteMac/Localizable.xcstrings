    "mac.vibe.walkie.needs.accessibility.access.to.read.the.active.field.f7cd725": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie needs Accessibility access to read the active field, type your dictation, and switch apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie benötigt Bedienungshilfen, um das aktive Feld zu lesen, dein Diktat einzufügen und Apps zu wechseln."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Vibe Walkie إلى إذن تسهيلات الاستخدام لقراءة الحقل النشط وإدخال نص الإملاء وتبديل التطبيقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie necessita accés a l’Accessibilitat per llegir el camp actiu, escriure el dictat i canviar d’app."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie skal have adgang til Tilgængelighed for at læse det aktive felt, skrive din diktering og skifte apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie potřebuje přístup ke Zpřístupnění, aby mohlo číst aktivní pole, psát diktovaný text a přepínat aplikace."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vibe Walkie χρειάζεται πρόσβαση στην Προσβασιμότητα για να διαβάζει το ενεργό πεδίο, να πληκτρολογεί την υπαγόρευσή σας και να αλλάζει εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie necesita permiso de Accesibilidad para leer el campo activo, escribir el texto dictado y cambiar de app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie tarvitsee Käyttöapu-oikeuden aktiivisen kentän lukemiseen, sanelun kirjoittamiseen ja sovellusten vaihtamiseen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie זקוק לגישת נגישות כדי לקרוא את השדה הפעיל, להקליד את ההכתבה ולעבור בין יישומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय फ़ील्ड पढ़ने, डिक्टेशन टाइप करने और ऐप बदलने के लिए Vibe Walkie को ऐक्सेसिबिलिटी की अनुमति चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie treba pristup Pristupačnosti kako bi pročitao aktivno polje, upisao diktat i mijenjao aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vibe Walkie-nak Kisegítő lehetőségek hozzáférésre van szüksége az aktív mező olvasásához, a diktált szöveg begépeléséhez és az alkalmazások váltásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie memerlukan izin Aksesibilitas untuk membaca kolom aktif, mengetik hasil dikte, dan beralih aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie richiede il permesso Accessibilità per leggere il campo attivo, inserire il testo dettato e cambiare app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のフィールドの読み取り、音声入力テキストの入力、アプリの切り替えを行うには、Vibe Walkieにアクセシビリティの使用を許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 필드를 읽고 받아쓰기 텍스트를 입력하며 앱을 전환하려면 Vibe Walkie에 손쉬운 사용 권한이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie memerlukan akses Kebolehcapaian untuk membaca medan aktif, menaip imlak anda dan menukar aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie trenger tilgang til Tilgjengelighet for å lese det aktive feltet, skrive dikteringen og bytte apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie heeft toegang tot Toegankelijkheid nodig om het actieve veld te lezen, dicteertekst te typen en tussen apps te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie wymaga uprawnienia Dostępność, aby odczytać aktywne pole, wpisać dyktowany tekst i przełączać aplikacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vibe Walkie precisa da permissão Acessibilidade para ler o campo ativo, inserir o texto ditado e trocar de app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie are nevoie de acces la Accesibilitate pentru a citi câmpul activ, a tasta dictarea și a comuta aplicațiile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie нужен Универсальный доступ, чтобы читать активное поле, вводить продиктованный текст и переключать приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie potrebuje prístup k Prístupnosti, aby mohlo čítať aktívne pole, písať diktovaný text a prepínať aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie behöver Hjälpmedel för att läsa det aktiva fältet, skriva din diktering och växla mellan appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie ต้องใช้การช่วยการเข้าถึงเพื่ออ่านช่องที่ใช้งาน พิมพ์ข้อความที่ป้อนตามคำบอก และสลับแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie etkin alanı okumak, dikte edilen metni yazmak ve uygulamalar arasında geçiş yapmak için Erişilebilirlik iznine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie потрібен доступ до Універсального доступу, щоб читати активне поле, вводити продиктований текст і перемикати програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie cần quyền Trợ năng để đọc trường đang hoạt động, nhập văn bản đọc chính tả và chuyển ứng dụng."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 需要輔助使用權限，先可以讀取使用中欄位、輸入聽寫文字同切換 App。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 需要辅助功能权限，才能读取当前文本栏、输入听写文本并切换 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 需要輔助使用權限，才能讀取目前使用中的文字欄位、輸入聽寫文字並切換 App。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie a besoin de l'Accessibilité pour lire le champ actif, y écrire votre dictée et changer d'application."
          }
        }
      }
    },
