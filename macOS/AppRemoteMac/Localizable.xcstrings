    "mac.the.mac.screen.is.locked.or.unavailable.unlock.the.mac.ee3612b": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac screen is locked or unavailable. Unlock the Mac session to resume control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac-Bildschirm ist gesperrt oder nicht verfügbar. Entsperre die Mac-Sitzung, um die Steuerung fortzusetzen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشة Mac مقفلة أو غير متاحة. افتح قفل جلسة Mac لاستئناف التحكم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla del Mac està bloquejada o no està disponible. Desbloqueja la sessió del Mac per reprendre el control."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-skærmen er låst eller ikke tilgængelig. Lås Mac-sessionen op for at fortsætte styringen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka Macu je zamčená nebo nedostupná. Odemknutím relace Macu obnovíte ovládání."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οθόνη του Mac είναι κλειδωμένη ή μη διαθέσιμη. Ξεκλειδώστε τη συνεδρία του Mac για να συνεχίσετε τον έλεγχο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla del Mac está bloqueada o no está disponible. Desbloquea la sesión del Mac para reanudar el control."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macin näyttö on lukittu tai ei käytettävissä. Jatka ohjausta avaamalla Mac-istunnon lukitus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסך ה‑Mac נעול או אינו זמין. בטלו את נעילת ה‑Mac כדי לחדש את השליטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac की स्क्रीन लॉक है या उपलब्ध नहीं है। कंट्रोल फिर शुरू करने के लिए Mac सेशन अनलॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaslon Maca je zaključan ili nedostupan. Otključajte sesiju na Macu kako biste nastavili upravljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac képernyője zárolva van vagy nem érhető el. A vezérlés folytatásához oldd fel a Mac munkamenetét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar Mac terkunci atau tidak tersedia. Buka kunci sesi Mac untuk melanjutkan kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo del Mac è bloccato o non disponibile. Sblocca la sessione del Mac per riprendere il controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの画面がロックされているか利用できません。操作を再開するにはMacのセッションをロック解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 화면이 잠겨 있거나 사용할 수 없습니다. 제어를 재개하려면 Mac 세션의 잠금을 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrin Mac dikunci atau tidak tersedia. Buka kunci sesi Mac untuk meneruskan kawalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-skjermen er låst eller utilgjengelig. Lås opp Mac-økten for å fortsette styringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Mac-scherm is vergrendeld of niet beschikbaar. Ontgrendel de Mac-sessie om de bediening te hervatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Maca jest zablokowany lub niedostępny. Odblokuj sesję Maca, aby wznowić sterowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela do Mac está bloqueada ou indisponível. Desbloqueie a sessão do Mac para retomar o controle."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul Mac-ului este blocat sau indisponibil. Deblochează sesiunea Mac pentru a relua controlul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран Mac заблокирован или недоступен. Разблокируйте сеанс Mac, чтобы продолжить управление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka Macu je zamknutá alebo nedostupná. Odomknutím relácie Macu obnovíte ovládanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-skärmen är låst eller inte tillgänglig. Lås upp Mac-sessionen för att återuppta styrningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอ Mac ล็อกอยู่หรือไม่พร้อมใช้งาน ปลดล็อกเซสชัน Mac เพื่อควบคุมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ekranı kilitli veya kullanılamıyor. Denetimi sürdürmek için Mac oturumunun kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран Mac заблокований або недоступний. Розблокуйте сеанс Mac, щоб відновити керування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình Mac bị khóa hoặc không khả dụng. Hãy mở khóa phiên Mac để tiếp tục điều khiển."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 螢幕已鎖定或者無法使用。請解鎖 Mac 工作階段以繼續控制。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 屏幕已锁定或不可用。请解锁 Mac 会话以继续控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 螢幕已鎖定或無法使用。請解鎖 Mac 工作階段以繼續控制。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran du Mac est verrouillé ou indisponible. Déverrouillez la session Mac pour reprendre le contrôle."
          }
        }
      }
    },
