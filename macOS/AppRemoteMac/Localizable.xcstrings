    "mac.on.iphone.return.to.vibewalkie.app.tap.test.then.scan.this.qr.7ec6a1f": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "On your iPhone, return to vibewalkie.app and tap “Try”. Then open Vibe Walkie and scan this QR code." } },
        "de": { "stringUnit": { "state": "translated", "value": "Rufe auf deinem iPhone erneut vibewalkie.app auf und tippe auf „Testen“. Öffne dann Vibe Walkie und scanne diesen QR-Code." } },
        "ar": { "stringUnit": { "state": "translated", "value": "على iPhone، ارجع إلى vibewalkie.app واضغط على «تجربة». ثم افتح Vibe Walkie وامسح رمز QR هذا." } },
        "ca": { "stringUnit": { "state": "translated", "value": "A l’iPhone, torna a vibewalkie.app i toca «Prova». Després obre Vibe Walkie i escaneja aquest codi QR." } },
        "da": { "stringUnit": { "state": "translated", "value": "Gå tilbage til vibewalkie.app på din iPhone, og tryk på “Prøv”. Åbn derefter Vibe Walkie, og scan denne QR-kode." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Na iPhonu se vraťte na vibewalkie.app a klepněte na „Vyzkoušet“. Potom otevřete Vibe Walkie a naskenujte tento QR kód." } },
        "el": { "stringUnit": { "state": "translated", "value": "Στο iPhone, επιστρέψτε στο vibewalkie.app και πατήστε «Δοκιμή». Στη συνέχεια ανοίξτε το Vibe Walkie και σαρώστε αυτόν τον κωδικό QR." } },
        "es": { "stringUnit": { "state": "translated", "value": "En el iPhone, vuelve a vibewalkie.app y toca «Probar». Después abre Vibe Walkie y escanea este código QR." } },
        "fi": { "stringUnit": { "state": "translated", "value": "Palaa iPhonella osoitteeseen vibewalkie.app ja napauta Kokeile. Avaa sitten Vibe Walkie ja skannaa tämä QR-koodi." } },
        "he": { "stringUnit": { "state": "translated", "value": "ב‑iPhone, חזרו אל vibewalkie.app והקישו על „התנסות”. לאחר מכן פתחו את Vibe Walkie וסרקו את קוד ה‑QR הזה." } },
        "hi": { "stringUnit": { "state": "translated", "value": "अपने iPhone पर vibewalkie.app पर वापस जाएँ और “आज़माएँ” पर टैप करें। फिर Vibe Walkie खोलें और यह QR कोड स्कैन करें।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Na iPhoneu se vratite na vibewalkie.app i dodirnite „Isprobaj”. Zatim otvorite Vibe Walkie i skenirajte ovaj QR kod." } },
        "hu": { "stringUnit": { "state": "translated", "value": "Az iPhone-on térj vissza a vibewalkie.app oldalra, és koppints a Kipróbálás lehetőségre. Ezután nyisd meg a Vibe Walkie-t, és olvasd be ezt a QR-kódot." } },
        "id": { "stringUnit": { "state": "translated", "value": "Di iPhone, kembali ke vibewalkie.app dan ketuk “Coba”. Lalu buka Vibe Walkie dan pindai kode QR ini." } },
        "it": { "stringUnit": { "state": "translated", "value": "Su iPhone, torna su vibewalkie.app e tocca “Prova”. Poi apri Vibe Walkie e scansiona questo codice QR." } },
        "ja": { "stringUnit": { "state": "translated", "value": "iPhoneでvibewalkie.appに戻り、「試す」をタップしてください。次にVibe Walkieを開き、このQRコードをスキャンします。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "iPhone에서 vibewalkie.app으로 돌아가 ‘사용해 보기’를 탭하세요. 그런 다음 Vibe Walkie를 열고 이 QR 코드를 스캔하세요." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Pada iPhone, kembali ke vibewalkie.app dan ketik “Cuba”. Kemudian buka Vibe Walkie dan imbas kod QR ini." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Gå tilbake til vibewalkie.app på iPhone og trykk på «Prøv». Åpne deretter Vibe Walkie og skann denne QR-koden." } },
        "nl": { "stringUnit": { "state": "translated", "value": "Ga op je iPhone terug naar vibewalkie.app en tik op ‘Probeer’. Open daarna Vibe Walkie en scan deze QR-code." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Na iPhonie wróć do vibewalkie.app i stuknij „Wypróbuj”. Następnie otwórz Vibe Walkie i zeskanuj ten kod QR." } },
        "pt": { "stringUnit": { "state": "translated", "value": "No iPhone, volte a vibewalkie.app e toque em “Experimentar”. Depois abra o Vibe Walkie e leia este código QR." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Pe iPhone, revino la vibewalkie.app și atinge „Încearcă”. Apoi deschide Vibe Walkie și scanează acest cod QR." } },
        "ru": { "stringUnit": { "state": "translated", "value": "На iPhone вернитесь на vibewalkie.app и нажмите «Попробовать». Затем откройте Vibe Walkie и отсканируйте этот QR‑код." } },
        "sk": { "stringUnit": { "state": "translated", "value": "Na iPhone sa vráťte na vibewalkie.app a klepnite na „Vyskúšať“. Potom otvorte Vibe Walkie a naskenujte tento QR kód." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Gå tillbaka till vibewalkie.app på iPhone och tryck på ”Prova”. Öppna sedan Vibe Walkie och skanna den här QR-koden." } },
        "th": { "stringUnit": { "state": "translated", "value": "บน iPhone ให้กลับไปที่ vibewalkie.app แล้วแตะ “ลองใช้” จากนั้นเปิด Vibe Walkie และสแกนรหัส QR นี้" } },
        "tr": { "stringUnit": { "state": "translated", "value": "iPhone’da vibewalkie.app sitesine dönüp “Dene”ye dokunun. Ardından Vibe Walkie’yi açıp bu QR kodunu tarayın." } },
        "uk": { "stringUnit": { "state": "translated", "value": "На iPhone поверніться на vibewalkie.app і натисніть «Спробувати». Потім відкрийте Vibe Walkie і відскануйте цей QR‑код." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Trên iPhone, quay lại vibewalkie.app và chạm vào “Dùng thử”. Sau đó mở Vibe Walkie và quét mã QR này." } },
        "yue": { "stringUnit": { "state": "translated", "value": "喺 iPhone 返回 vibewalkie.app，再點按「試用」。然後開啟 Vibe Walkie 並掃描呢個 QR 碼。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在 iPhone 上返回 vibewalkie.app，轻点“试用”。然后打开 Vibe Walkie 并扫描此二维码。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在 iPhone 上返回 vibewalkie.app，點一下「試用」。然後開啟 Vibe Walkie 並掃描此 QR 碼。" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Sur l’iPhone, revenez sur vibewalkie.app et touchez « Tester ». Ouvrez ensuite Vibe Walkie et scannez ce QR code." } }
      }
    },
    "mac.configure.later.17b69c4": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Configure later" } },
        "de": { "stringUnit": { "state": "translated", "value": "Später konfigurieren" } },
        "ar": { "stringUnit": { "state": "translated", "value": "الإعداد لاحقًا" } },
        "ca": { "stringUnit": { "state": "translated", "value": "Configura-ho més tard" } },
        "da": { "stringUnit": { "state": "translated", "value": "Konfigurer senere" } },
        "cs": { "stringUnit": { "state": "translated", "value": "Nastavit později" } },
        "el": { "stringUnit": { "state": "translated", "value": "Διαμόρφωση αργότερα" } },
        "es": { "stringUnit": { "state": "translated", "value": "Configurar más tarde" } },
        "fi": { "stringUnit": { "state": "translated", "value": "Määritä myöhemmin" } },
        "he": { "stringUnit": { "state": "translated", "value": "הגדרה מאוחר יותר" } },
        "hi": { "stringUnit": { "state": "translated", "value": "बाद में कॉन्फ़िगर करें" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Postavi kasnije" } },
        "hu": { "stringUnit": { "state": "translated", "value": "Beállítás később" } },
        "id": { "stringUnit": { "state": "translated", "value": "Atur nanti" } },
        "it": { "stringUnit": { "state": "translated", "value": "Configura più tardi" } },
        "ja": { "stringUnit": { "state": "translated", "value": "後で設定" } },
        "ko": { "stringUnit": { "state": "translated", "value": "나중에 설정" } },
        "ms": { "stringUnit": { "state": "translated", "value": "Konfigurasikan kemudian" } },
        "nb": { "stringUnit": { "state": "translated", "value": "Konfigurer senere" } },
        "nl": { "stringUnit": { "state": "translated", "value": "Later configureren" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Skonfiguruj później" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Configurar mais tarde" } },
        "ro": { "stringUnit": { "state": "translated", "value": "Configurează mai târziu" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Настроить позже" } },
        "sk": { "stringUnit": { "state": "translated", "value": "Nastaviť neskôr" } },
        "sv": { "stringUnit": { "state": "translated", "value": "Konfigurera senare" } },
        "th": { "stringUnit": { "state": "translated", "value": "ตั้งค่าภายหลัง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Daha sonra yapılandır" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Налаштувати пізніше" } },
        "vi": { "stringUnit": { "state": "translated", "value": "Thiết lập sau" } },
        "yue": { "stringUnit": { "state": "translated", "value": "遲啲設定" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "稍后配置" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "稍後設定" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Configurer plus tard" } }
      }
    },
    "mac.nomad.discovery.body.f6e2a71": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use Vibe Walkie outside your local Wi‑Fi. Tailscale creates a private encrypted network between your iPhone and Mac, without opening router ports. Tailscale is a separate service and requires its own account." } },
        "de": { "stringUnit": { "state": "translated", "value": "Verwende Vibe Walkie außerhalb deines lokalen WLANs. Tailscale erstellt ein privates, verschlüsseltes Netzwerk zwischen deinem iPhone und Mac, ohne Router-Ports zu öffnen. Tailscale ist ein separater Dienst und erfordert ein eigenes Konto." } },
        "ar": { "stringUnit": { "state": "translated", "value": "استخدم Vibe Walkie خارج شبكة Wi‑Fi المحلية. ينشئ Tailscale شبكة خاصة مشفرة بين iPhone وMac من دون فتح منافذ جهاز التوجيه. Tailscale خدمة منفصلة وتتطلب حسابًا خاصًا بها." } },
        "ca": { "stringUnit": { "state": "translated", "value": "Utilitza Vibe Walkie fora de la xarxa Wi‑Fi local. Tailscale crea una xarxa privada xifrada entre l’iPhone i el Mac sense obrir ports de l’encaminador. Tailscale és un servei independent i requereix un compte propi." } },
        "da": { "stringUnit": { "state": "translated", "value": "Brug Vibe Walkie uden for dit lokale Wi‑Fi. Tailscale opretter et privat, krypteret netværk mellem din iPhone og Mac uden at åbne porte i routeren. Tailscale er en separat tjeneste og kræver sin egen konto." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Používejte Vibe Walkie mimo místní Wi‑Fi. Tailscale vytvoří soukromou šifrovanou síť mezi iPhonem a Macem bez otevírání portů na routeru. Tailscale je samostatná služba a vyžaduje vlastní účet." } },
        "el": { "stringUnit": { "state": "translated", "value": "Χρησιμοποιήστε το Vibe Walkie εκτός του τοπικού Wi‑Fi. Το Tailscale δημιουργεί ένα ιδιωτικό κρυπτογραφημένο δίκτυο μεταξύ iPhone και Mac, χωρίς άνοιγμα θυρών στο router. Το Tailscale είναι ξεχωριστή υπηρεσία και απαιτεί δικό του λογαριασμό." } },
        "es": { "stringUnit": { "state": "translated", "value": "Usa Vibe Walkie fuera de tu Wi‑Fi local. Tailscale crea una red privada cifrada entre el iPhone y el Mac sin abrir puertos del router. Tailscale es un servicio independiente y requiere su propia cuenta." } },
        "fi": { "stringUnit": { "state": "translated", "value": "Käytä Vibe Walkieta paikallisen Wi‑Fi-verkon ulkopuolella. Tailscale luo yksityisen salatun verkon iPhonen ja Macin välille ilman reitittimen porttien avaamista. Tailscale on erillinen palvelu ja vaatii oman tilin." } },
        "he": { "stringUnit": { "state": "translated", "value": "אפשר להשתמש ב‑Vibe Walkie מחוץ לרשת ה‑Wi‑Fi המקומית. Tailscale יוצר רשת פרטית ומוצפנת בין ה‑iPhone ל‑Mac בלי לפתוח יציאות בנתב. Tailscale הוא שירות נפרד ודורש חשבון משלו." } },
        "hi": { "stringUnit": { "state": "translated", "value": "अपने स्थानीय Wi‑Fi से बाहर Vibe Walkie का उपयोग करें। Tailscale राउटर पोर्ट खोले बिना आपके iPhone और Mac के बीच एक निजी एन्क्रिप्टेड नेटवर्क बनाता है। Tailscale एक अलग सेवा है और इसके लिए अलग खाता चाहिए।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Koristite Vibe Walkie izvan lokalne Wi‑Fi mreže. Tailscale stvara privatnu šifriranu mrežu između iPhonea i Maca bez otvaranja priključaka na usmjerivaču. Tailscale je zasebna usluga i zahtijeva vlastiti račun." } },
        "hu": { "stringUnit": { "state": "translated", "value": "Használd a Vibe Walkie-t a helyi Wi‑Fi hálózaton kívül is. A Tailscale privát, titkosított hálózatot hoz létre az iPhone és a Mac között a router portjainak megnyitása nélkül. A Tailscale külön szolgáltatás, amely saját fiókot igényel." } },
        "id": { "stringUnit": { "state": "translated", "value": "Gunakan Vibe Walkie di luar Wi‑Fi lokal. Tailscale membuat jaringan pribadi terenkripsi antara iPhone dan Mac tanpa membuka port router. Tailscale adalah layanan terpisah dan memerlukan akun tersendiri." } },
        "it": { "stringUnit": { "state": "translated", "value": "Usa Vibe Walkie fuori dalla rete Wi‑Fi locale. Tailscale crea una rete privata crittografata tra iPhone e Mac senza aprire porte sul router. Tailscale è un servizio separato e richiede un proprio account." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ローカルWi‑Fiの外でもVibe Walkieを使用できます。Tailscaleはルーターのポートを開放せずに、iPhoneとMacの間にプライベートな暗号化ネットワークを作成します。Tailscaleは別のサービスで、専用アカウントが必要です。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "로컬 Wi‑Fi 밖에서도 Vibe Walkie를 사용하세요. Tailscale은 라우터 포트를 열지 않고 iPhone과 Mac 사이에 비공개 암호화 네트워크를 만듭니다. Tailscale은 별도 서비스이며 자체 계정이 필요합니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Gunakan Vibe Walkie di luar Wi‑Fi setempat. Tailscale mencipta rangkaian peribadi yang disulitkan antara iPhone dan Mac tanpa membuka port penghala. Tailscale ialah perkhidmatan berasingan dan memerlukan akaunnya sendiri." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Bruk Vibe Walkie utenfor det lokale Wi‑Fi-nettverket. Tailscale oppretter et privat, kryptert nettverk mellom iPhone og Mac uten å åpne porter i ruteren. Tailscale er en separat tjeneste og krever en egen konto." } },
        "nl": { "stringUnit": { "state": "translated", "value": "Gebruik Vibe Walkie buiten je lokale wifi. Tailscale maakt een privé, versleuteld netwerk tussen je iPhone en Mac zonder routerpoorten te openen. Tailscale is een aparte dienst en vereist een eigen account." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Korzystaj z Vibe Walkie poza lokalną siecią Wi‑Fi. Tailscale tworzy prywatną, szyfrowaną sieć między iPhonem a Makiem bez otwierania portów routera. Tailscale jest oddzielną usługą i wymaga własnego konta." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Use o Vibe Walkie fora da rede Wi‑Fi local. O Tailscale cria uma rede privada encriptada entre o iPhone e o Mac sem abrir portas no router. O Tailscale é um serviço separado e requer uma conta própria." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Folosește Vibe Walkie în afara rețelei Wi‑Fi locale. Tailscale creează o rețea privată criptată între iPhone și Mac fără a deschide porturi pe router. Tailscale este un serviciu separat și necesită propriul cont." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Используйте Vibe Walkie за пределами локальной сети Wi‑Fi. Tailscale создаёт частную зашифрованную сеть между iPhone и Mac без открытия портов роутера. Tailscale — отдельный сервис, для которого требуется собственная учётная запись." } },
        "sk": { "stringUnit": { "state": "translated", "value": "Používajte Vibe Walkie mimo miestnej siete Wi‑Fi. Tailscale vytvorí súkromnú šifrovanú sieť medzi iPhonom a Macom bez otvárania portov na smerovači. Tailscale je samostatná služba a vyžaduje vlastný účet." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Använd Vibe Walkie utanför ditt lokala Wi‑Fi. Tailscale skapar ett privat krypterat nätverk mellan din iPhone och Mac utan att öppna portar i routern. Tailscale är en separat tjänst och kräver ett eget konto." } },
        "th": { "stringUnit": { "state": "translated", "value": "ใช้ Vibe Walkie นอกเครือข่าย Wi‑Fi ภายในได้ Tailscale จะสร้างเครือข่ายส่วนตัวที่เข้ารหัสระหว่าง iPhone และ Mac โดยไม่ต้องเปิดพอร์ตเราเตอร์ Tailscale เป็นบริการแยกต่างหากและต้องใช้บัญชีของตนเอง" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie’yi yerel Wi‑Fi ağınızın dışında kullanın. Tailscale, yönlendirici bağlantı noktalarını açmadan iPhone ile Mac arasında özel ve şifreli bir ağ oluşturur. Tailscale ayrı bir hizmettir ve kendi hesabını gerektirir." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Використовуйте Vibe Walkie поза локальною мережею Wi‑Fi. Tailscale створює приватну зашифровану мережу між iPhone і Mac без відкриття портів маршрутизатора. Tailscale — окремий сервіс, для якого потрібен власний обліковий запис." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Sử dụng Vibe Walkie bên ngoài Wi‑Fi cục bộ. Tailscale tạo mạng riêng được mã hóa giữa iPhone và Mac mà không cần mở cổng bộ định tuyến. Tailscale là dịch vụ riêng biệt và yêu cầu tài khoản riêng." } },
        "yue": { "stringUnit": { "state": "translated", "value": "喺本地 Wi‑Fi 以外使用 Vibe Walkie。Tailscale 會喺 iPhone 同 Mac 之間建立私人加密網絡，毋須開放路由器連接埠。Tailscale 係獨立服務，需要使用其帳戶。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在本地 Wi‑Fi 之外使用 Vibe Walkie。Tailscale 会在 iPhone 和 Mac 之间创建私密加密网络，无需开放路由器端口。Tailscale 是独立服务，需要单独的账户。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "在本地 Wi‑Fi 之外使用 Vibe Walkie。Tailscale 會在 iPhone 和 Mac 之間建立私密加密網絡，無需開放路由器連接埠。Tailscale 是獨立服務，需要單獨的帳戶。" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Utilisez Vibe Walkie loin de votre Wi‑Fi local. Tailscale crée un réseau privé chiffré entre votre iPhone et votre Mac, sans ouvrir de ports sur le routeur. Tailscale est un service séparé qui nécessite son propre compte." } }
      }
    },
