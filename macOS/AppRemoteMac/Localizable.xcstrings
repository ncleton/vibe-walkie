    "mac.vibe.walkie.will.relaunch.automatically.after.the.update.9b9d835": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Vibe Walkie will relaunch automatically after the update." } },
        "ar": { "stringUnit": { "state": "translated", "value": "سيُعاد تشغيل Vibe Walkie تلقائيًا بعد التحديث." } },
        "ca": { "stringUnit": { "state": "translated", "value": "Vibe Walkie es tornarà a obrir automàticament després de l’actualització." } },
        "cs": { "stringUnit": { "state": "translated", "value": "Vibe Walkie se po aktualizaci automaticky znovu spustí." } },
        "da": { "stringUnit": { "state": "translated", "value": "Vibe Walkie starter automatisk igen efter opdateringen." } },
        "de": { "stringUnit": { "state": "translated", "value": "Vibe Walkie wird nach dem Update automatisch neu gestartet." } },
        "el": { "stringUnit": { "state": "translated", "value": "Το Vibe Walkie θα επανεκκινηθεί αυτόματα μετά την ενημέρωση." } },
        "es": { "stringUnit": { "state": "translated", "value": "Vibe Walkie se volverá a abrir automáticamente después de la actualización." } },
        "fi": { "stringUnit": { "state": "translated", "value": "Vibe Walkie käynnistyy automaattisesti uudelleen päivityksen jälkeen." } },
        "he": { "stringUnit": { "state": "translated", "value": "Vibe Walkie יופעל מחדש באופן אוטומטי לאחר העדכון." } },
        "hi": { "stringUnit": { "state": "translated", "value": "अपडेट के बाद Vibe Walkie अपने-आप फिर से शुरू होगा।" } },
        "hr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie automatski će se ponovno pokrenuti nakon ažuriranja." } },
        "hu": { "stringUnit": { "state": "translated", "value": "A Vibe Walkie a frissítés után automatikusan újraindul." } },
        "id": { "stringUnit": { "state": "translated", "value": "Vibe Walkie akan dimulai ulang secara otomatis setelah pembaruan." } },
        "it": { "stringUnit": { "state": "translated", "value": "Vibe Walkie si riavvierà automaticamente dopo l’aggiornamento." } },
        "ja": { "stringUnit": { "state": "translated", "value": "アップデート後、Vibe Walkieは自動的に再起動します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "업데이트 후 Vibe Walkie가 자동으로 다시 실행됩니다." } },
        "ms": { "stringUnit": { "state": "translated", "value": "Vibe Walkie akan dilancarkan semula secara automatik selepas kemas kini." } },
        "nb": { "stringUnit": { "state": "translated", "value": "Vibe Walkie starter automatisk på nytt etter oppdateringen." } },
        "nl": { "stringUnit": { "state": "translated", "value": "Vibe Walkie wordt na de update automatisch opnieuw gestart." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Vibe Walkie uruchomi się ponownie automatycznie po uaktualnieniu." } },
        "pt": { "stringUnit": { "state": "translated", "value": "O Vibe Walkie será reiniciado automaticamente após a atualização." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Vibe Walkie va reporni automat după actualizare." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Vibe Walkie автоматически перезапустится после обновления." } },
        "sk": { "stringUnit": { "state": "translated", "value": "Vibe Walkie sa po aktualizácii automaticky znova spustí." } },
        "sv": { "stringUnit": { "state": "translated", "value": "Vibe Walkie startar om automatiskt efter uppdateringen." } },
        "th": { "stringUnit": { "state": "translated", "value": "Vibe Walkie จะเปิดใหม่โดยอัตโนมัติหลังจากอัปเดต" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie güncellemeden sonra otomatik olarak yeniden başlatılacak." } },
        "uk": { "stringUnit": { "state": "translated", "value": "Vibe Walkie автоматично перезапуститься після оновлення." } },
        "vi": { "stringUnit": { "state": "translated", "value": "Vibe Walkie sẽ tự động khởi động lại sau khi cập nhật." } },
        "yue": { "stringUnit": { "state": "translated", "value": "更新後，Vibe Walkie 會自動重新啟動。" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "更新后，Vibe Walkie 将自动重新启动。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "更新後，Vibe Walkie 將自動重新啟動。" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Vibe Walkie se relancera automatiquement après la mise à jour." } }
      }
    },
