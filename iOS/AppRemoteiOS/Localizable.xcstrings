    "ios.pointer.and.scroll.speeds.can.be.adjusted.independently.up.to.23da271": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointer and scroll speeds can be adjusted independently, up to 6× and 5×."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger- und Scrollgeschwindigkeit lassen sich unabhängig bis auf 6× bzw. 5× einstellen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن ضبط سرعتي المؤشر والتمرير كلٌّ على حدة، حتى 6× و5×."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les velocitats del punter i del desplaçament es poden ajustar per separat, fins a 6× i 5×."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markør- og rullehastigheden kan justeres separat, op til 6× og 5×."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rychlost ukazatele a posouvání lze upravit nezávisle, až na 6× a 5×."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ταχύτητες του δείκτη και της κύλισης ρυθμίζονται ανεξάρτητα, έως 6× και 5×."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las velocidades del puntero y de desplazamiento se pueden ajustar por separado hasta 6× y 5×."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoittimen ja vierityksen nopeuksia voi säätää erikseen, enintään 6× ja 5×."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לכוון בנפרד את מהירות המצביע והגלילה, עד פי 6 ופי 5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पॉइंटर और स्क्रोल की रफ़्तार अलग-अलग, अधिकतम 6× और 5× तक सेट की जा सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brzine pokazivača i pomicanja mogu se zasebno podesiti, do 6× i 5×."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mutató és a görgetés sebessége külön állítható, legfeljebb 6×, illetve 5× értékig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecepatan penunjuk dan gulir dapat diatur secara terpisah, hingga 6× dan 5×."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le velocità del puntatore e di scorrimento possono essere regolate separatamente, fino a 6× e 5×."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタ速度とスクロール速度は個別に調整でき、それぞれ最大6倍と5倍に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터와 스크롤 속도를 각각 최대 6배와 5배까지 따로 조절할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelajuan penuding dan tatal boleh dilaraskan secara berasingan, sehingga 6× dan 5×."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Peker- og rullehastigheten kan justeres separat, opptil 6× og 5×."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanwijzer- en scrolsnelheid zijn afzonderlijk instelbaar tot 6× en 5×."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prędkość wskaźnika i przewijania można dostosowywać niezależnie, do 6× i 5×."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As velocidades de ponteiro e de rolagem podem ser ajustadas de forma independente, até 6× e 5×."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitezele cursorului și derulării pot fi reglate separat, până la 6× și 5×."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость указателя и прокрутки регулируются отдельно: до 6× и 5× соответственно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rýchlosť ukazovateľa a posúvania možno nastaviť nezávisle, až na 6× a 5×."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekar- och rullhastigheten kan justeras separat, upp till 6× respektive 5×."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับความเร็วตัวชี้และการเลื่อนได้แยกกัน สูงสุด 6× และ 5×"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçi ve kaydırma hızları birbirinden bağımsız olarak 6× ve 5× değerlerine kadar ayarlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидкість вказівника та прокручування можна регулювати окремо — до 6× і 5×."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể điều chỉnh riêng tốc độ con trỏ và tốc độ cuộn, tối đa 6× và 5×."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "游標同捲動速度可以分開調整，最高分別係 6× 同 5×。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针和滚动速度可分别调整，最高为 6× 和 5×。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標和捲動速度可分別調整，最高為 6× 和 5×。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le curseur et le défilement se règlent indépendamment, jusqu’à 6× et 5×."
          }
        }
      }
    },
