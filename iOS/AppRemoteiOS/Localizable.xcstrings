    "ios.your.voice.is.processed.on.this.iphone.using.apple.models.620b855": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice is processed on this iPhone using Apple models. No audio is sent to the cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme wird auf diesem iPhone mit Apple-Modellen verarbeitet. Es wird kein Audio in die Cloud gesendet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة صوتك على هذا الـ iPhone باستخدام نماذج Apple. ولا يُرسل أي صوت إلى السحابة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva veu es processa en aquest iPhone amb models d’Apple. No s’envia àudio al núvol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stemme behandles på denne iPhone med Apple-modeller. Ingen lyd sendes til skyen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš hlas se zpracovává na tomto iPhonu pomocí modelů Apple. Do cloudu se neposílá žádný zvuk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φωνή σας επεξεργάζεται σε αυτό το iPhone με μοντέλα Apple. Δεν αποστέλλεται ήχος στο cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz se procesa en este iPhone con modelos de Apple. No se envía audio a la nube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänesi käsitellään tässä iPhonessa Applen malleilla. Ääntä ei lähetetä pilveen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקול שלכם מעובד ב‑iPhone הזה באמצעות מודלים של Apple. שום שמע אינו נשלח לענן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आवाज़ इस iPhone पर Apple मॉडल से प्रोसेस होती है। कोई ऑडियो क्लाउड पर नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš se glas obrađuje na ovom iPhoneu pomoću Appleovih modela. Zvuk se ne šalje u oblak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hangodat ezen az iPhone-on dolgozzák fel Apple-modellekkel. Nem küldünk hangot a felhőbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Anda diproses di iPhone ini menggunakan model Apple. Tidak ada audio yang dikirim ke cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce viene elaborata su questo iPhone utilizzando modelli Apple. Nessun audio viene inviato al cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はAppleのモデルを使ってこのiPhone上で処理されます。音声がクラウドに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성은 Apple 모델을 사용하여 이 iPhone에서 처리됩니다. 오디오는 클라우드로 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara anda diproses pada iPhone ini menggunakan model Apple. Tiada audio dihantar ke awan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen din behandles på denne iPhonen med Apple-modeller. Ingen lyd sendes til skyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem wordt op deze iPhone verwerkt met Apple-modellen. Er wordt geen audio naar de cloud gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój głos jest przetwarzany na tym iPhonie za pomocą modeli Apple. Żaden dźwięk nie jest wysyłany do chmury."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz é processada neste iPhone com modelos da Apple. Nenhum áudio é enviado à nuvem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea ta este procesată pe acest iPhone folosind modele Apple. Niciun sunet nu este trimis în cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос обрабатывается на этом iPhone с помощью моделей Apple. Аудио не отправляется в облако."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš hlas sa spracúva na tomto iPhone pomocou modelov Apple. Do cloudu sa neposiela žiadny zvuk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din röst behandlas på denna iPhone med Apple-modeller. Inget ljud skickas till molnet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณได้รับการประมวลผลบน iPhone เครื่องนี้ด้วยโมเดลของ Apple ไม่มีการส่งเสียงไปยังคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiniz bu iPhone'da Apple modelleriyle işlenir. Buluta hiçbir ses gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш голос обробляється на цьому iPhone за допомогою моделей Apple. Аудіо не надсилається в хмару."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng nói của bạn được xử lý trên iPhone này bằng các mô hình Apple. Không có âm thanh nào được gửi lên đám mây."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "你嘅語音會用 Apple 模型喺呢部 iPhone 處理，唔會將音訊傳送到雲端。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的声音由 Apple 模型在这台 iPhone 上处理。不会向云端发送任何音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聲音由 Apple 模型在這台 iPhone 上處理。不會向雲端傳送任何音訊。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix est analysée sur cet iPhone avec les modèles Apple. Aucun audio n’est envoyé dans le cloud."
          }
        }
      }
    },
