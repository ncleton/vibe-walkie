    "premium.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock every Vibe Walkie control on your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez toutes les commandes Vibe Walkie sur votre Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإلغاء قفل كل عنصر تحكم Vibe Walkie على جهاز Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueja tots els controls de Vibe Walkie al teu Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemkněte každý Vibe Walkie ovládací prvek na vašem Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås op for hver Vibe Walkie kontrol på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie alle Vibe Walkie-Steuerelemente auf Ihrem Mac frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε κάθε στοιχείο ελέγχου Vibe Walkie στο Mac σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea todos los controles Vibe Walkie en tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kaikki Vibe Walkie-ohjaimet Mac-laitteellasi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל את הנעילה של כל פקד Vibe Walkie ב-Mac שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Mac पर प्रत्येक Vibe Walkie नियंत्रण को अनलॉक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključajte svaku kontrolu Vibe Walkie na svom Mac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldja fel az összes Vibe Walkie vezérlőt Mac eszközén."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci setiap kontrol Vibe Walkie di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca tutti i controlli Vibe Walkie sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上のすべての Vibe Walkie コントロールのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 모든 Vibe Walkie 컨트롤을 잠금 해제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci setiap kawalan Vibe Walkie pada Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp hver Vibe Walkie-kontroll på Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel elk Vibe Walkie-besturingselement op uw Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj wszystkie elementy sterujące Vibe Walkie na swoim Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie todos os controles Vibe Walkie no seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocați fiecare control Vibe Walkie de pe Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте все элементы управления Vibe Walkie на вашем Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odomknite všetky ovládacie prvky Vibe Walkie na svojom zariadení Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp varje Vibe Walkie-kontroll på din Mac."
          }
        },
        "th": {
