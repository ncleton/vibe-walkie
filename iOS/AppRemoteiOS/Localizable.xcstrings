    "ios.open.vibe.walkie.on.your.mac.then.choose.pair.an.f275c3d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the companion on your Mac, Windows PC or Linux server, then generate its pairing QR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Vibe Walkie auf deinem Mac und wähle „iPhone koppeln“."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Vibe Walkie على Mac، ثم اختر «إقران iPhone»."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Vibe Walkie al Mac i tria «Enllaça un iPhone»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Vibe Walkie på din Mac, og vælg derefter “Par en iPhone”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Vibe Walkie na Macu a vyberte „Spárovat iPhone“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Vibe Walkie στο Mac και επιλέξτε «Σύζευξη iPhone»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Vibe Walkie en el Mac y elige “Emparejar un iPhone”."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Vibe Walkie Macissa ja valitse sitten ”Muodosta laitepari iPhonen kanssa”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את Vibe Walkie ב‑Mac ובחרו „קישור iPhone”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac पर Vibe Walkie खोलें, फिर “iPhone पेयर करें” चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Vibe Walkie na Macu, zatim odaberite „Upari iPhone”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Vibe Walkie-t a Macen, majd válaszd az „iPhone párosítása” lehetőséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Vibe Walkie di Mac Anda, lalu pilih “Pasangkan iPhone”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Vibe Walkie sul Mac, poi scegli “Abbina un iPhone”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでVibe Walkieを開き、「iPhoneをペアリング」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Vibe Walkie를 열고 ‘iPhone 페어링’을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Vibe Walkie pada Mac, kemudian pilih “Pasangkan iPhone.”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Vibe Walkie på Macen, og velg deretter «Koble sammen en iPhone»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Vibe Walkie op je Mac en kies vervolgens 'Koppel een iPhone'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Vibe Walkie na Macu, a następnie wybierz „Sparuj iPhone'a”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Vibe Walkie no Mac e escolha “Emparelhar um iPhone”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Vibe Walkie pe Mac, apoi alege „Asociază un iPhone”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Vibe Walkie на Mac и выберите «Связать iPhone»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte Vibe Walkie na Macu a vyberte „Spárovať iPhone“."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Vibe Walkie på din Mac och välj sedan ”Parkoppla en iPhone”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vibe Walkie บน Mac แล้วเลือก “จับคู่ iPhone”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde Vibe Walkie'yi açın, ardından “Bir iPhone Eşleştir”i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Vibe Walkie на Mac і виберіть «Спарити iPhone»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Vibe Walkie trên Mac, sau đó chọn “Ghép đôi iPhone”."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "喺 Mac 開啟 Vibe Walkie，然後選擇「配對 iPhone」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 Vibe Walkie，然后选择“配对 iPhone”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上開啟 Vibe Walkie，然後選擇「配對 iPhone」。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le compagnon sur votre Mac, PC Windows ou serveur Linux, puis générez son QR d’appairage."
          }
        }
      }
    },
