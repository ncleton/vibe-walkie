    "ios.health.longevity.projection.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Population association compared with no leisure-time moderate-to-vigorous activity—not an individual prediction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Association observée dans une population, comparée à l’absence d’activité de loisir modérée à vigoureuse — pas une prédiction individuelle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الارتباط السكاني مقارنة بعدم وجود نشاط معتدل إلى قوي في وقت الفراغ - وليس تنبؤًا فرديًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Associació de població en comparació amb l'absència d'activitats moderades a vigoroses en el temps lliure, no una predicció individual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Populační asociace ve srovnání s žádnou mírnou až intenzivní aktivitou ve volném čase – není to individuální předpověď."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolkningssammenslutning sammenlignet med ingen moderat til kraftig aktivitet i fritiden - ikke en individuel forudsigelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevölkerungsassoziation im Vergleich zu keiner mäßigen bis intensiven Freizeitaktivität – keine individuelle Vorhersage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συσχέτιση πληθυσμού σε σύγκριση με καμία μέτρια έως έντονη δραστηριότητα στον ελεύθερο χρόνο - όχι μια ατομική πρόβλεψη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La asociación de la población en comparación con la ausencia de actividad de moderada a vigorosa en el tiempo libre no es una predicción individual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Väestöyhdistys verrattuna siihen, ettei vapaa-aikaa ole keskivaikeasta voimakkaaseen toimintaan – ei yksilöllinen ennuste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאגדות אוכלוסייה בהשוואה ללא פעילות מתונה עד נמרצת בשעות הפנאי - לא תחזית אינדיבידואלית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जनसंख्या संघ की तुलना फुरसत के समय की मध्यम से जोरदार गतिविधि से की गई है - यह कोई व्यक्तिगत भविष्यवाणी नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezanost stanovništva u usporedbi s umjerenom do snažnom aktivnošću bez slobodnog vremena - nije individualno predviđanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lakossági asszociáció összehasonlítva azzal, hogy nincs szabadidős, közepestől erőteljesig terjedő tevékenység – nem egyéni előrejelzés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Asosiasi populasi dibandingkan dengan tidak adanya aktivitas sedang hingga berat di waktu senggang—bukan merupakan prediksi individu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associazione della popolazione rispetto all'assenza di attività da moderata a intensa nel tempo libero: non è una previsione individuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の予測ではなく、余暇に中程度から激しい活動をしない場合と比較した集団の関連性。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여가 시간에 중간 정도부터 활발한 활동을 하지 않는 것과 비교한 인구 연관성 - 개별적인 예측이 아닙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkaitan penduduk berbanding dengan tiada aktiviti masa lapang yang sederhana hingga rancak—bukan ramalan individu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolkningssammenslutning sammenlignet med ingen moderat til kraftig aktivitet i fritiden - ikke en individuell prediksjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevolkingsassociatie vergeleken met geen matige tot intensieve activiteit in de vrije tijd – geen individuele voorspelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie populacji z brakiem umiarkowanej lub intensywnej aktywności w czasie wolnym – nie jest to prognoza indywidualna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Associação populacional comparada com nenhuma atividade de lazer moderada a vigorosa – não é uma previsão individual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asocierea populației în comparație cu nicio activitate moderată până la viguroasă în timpul liber - nu o predicție individuală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассоциация населения по сравнению с отсутствием активности в свободное время от умеренной до активной — не индивидуальный прогноз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Asociácia populácie v porovnaní so žiadnou miernou až intenzívnou aktivitou vo voľnom čase – nie je to individuálna predpoveď."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Befolkningssammanslutning jämfört med ingen måttlig till kraftig aktivitet på fritiden – inte en individuell förutsägelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสัมพันธ์ของประชากรเมื่อเปรียบเทียบกับการไม่มีกิจกรรมยามว่างในระดับปานกลางถึงแข็งแรง ไม่ใช่การคาดการณ์รายบุคคล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş zamanlarında orta-yoğun aktivite yapılmaması ile karşılaştırıldığında nüfus ilişkisi; bireysel bir tahmin değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Асоціація населення порівняно з відсутністю вільного часу від помірної до інтенсивної діяльності — не індивідуальний прогноз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mối liên hệ về dân số được so sánh với việc không có hoạt động ở mức độ vừa phải đến mạnh mẽ trong thời gian rảnh rỗi—không phải là một dự đoán cá nhân."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "人口關聯同冇閒暇時間嘅中度至強烈活動相比 — 唔係個別預測。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人口关联与没有休闲时间中度至剧烈活动的比较——不是个人预测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人口關聯與沒有休閒時間中度至劇烈活動的比較－不是個人預測。"
          }
        }
      }
    },
