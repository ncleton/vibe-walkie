    "ios.hold.to.dictate.release.to.insert.on.the.mac.14cabfc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to dictate, release to insert on the computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Diktieren gedrückt halten, zum Einfügen auf dem Mac loslassen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً للإملاء، ثم ارفع إصبعك لإدخال النص على Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut per dictar i deixa anar per inserir el text al Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede for at diktere, og slip for at indsætte teksten på Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením diktujte, uvolněním vložte text do Macu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένο για υπαγόρευση και αφήστε για εισαγωγή στο Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para dictar y suelta para insertar el texto en el Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanele pitämällä painettuna ja lisää teksti Maciin vapauttamalla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו כדי להכתיב ושחררו כדי להזין ב‑Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिक्टेशन के लिए दबाकर रखें और Mac पर टेक्स्ट डालने के लिए छोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite za diktiranje, otpustite za umetanje na Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd lenyomva a diktáláshoz, engedd fel a Macen való beszúráshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan untuk mendikte, lalu lepas untuk memasukkan teks di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per dettare e rilascia per inserire il testo sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しして音声入力し、指を離すとMacにテキストが入力されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌러 받아쓰고 손을 떼면 Mac에 텍스트가 입력됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan untuk mengimlak, lepaskan untuk memasukkan teks pada Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold inne for å diktere, og slipp for å sette inn teksten på Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ingedrukt om te dicteren en laat los om tekst op de Mac in te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj, aby dyktować, i puść, aby wstawić tekst na Macu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pressionado para ditar e solte para inserir no Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat pentru a dicta, eliberează pentru a insera pe Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте для диктовки и отпустите, чтобы вставить текст на Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržaním diktujte, uvoľnením vložte text do Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ned för att diktera och släpp för att infoga texten på Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างเพื่อป้อนตามคำบอก แล้วปล่อยเพื่อใส่ข้อความบน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte etmek için basılı tutun, metni Mac’e eklemek için bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте, щоб диктувати, і відпустіть, щоб вставити текст на Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ để đọc chính tả, rồi thả ra để nhập văn bản trên Mac."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "按住嚟聽寫，放手就會將文字輸入 Mac。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住即可听写，松开后将文本输入 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住即可聽寫，鬆開後將文字輸入 Mac。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez pour dicter, relâchez pour insérer sur l’ordinateur."
          }
        }
      }
    },
