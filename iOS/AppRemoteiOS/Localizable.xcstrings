    "ios.in.editor.mode.the.draft.stays.on.the.iphone.until.5b5d191": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Editor mode, the draft stays on the iPhone until it is sent or the keyboard closes. It is never saved in a history."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Editor-Modus bleibt der Entwurf auf dem iPhone, bis er gesendet oder die Tastatur geschlossen wird. Er wird nie in einem Verlauf gespeichert."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع المحرر، تبقى المسودة على iPhone حتى تُرسل أو تُغلق لوحة المفاتيح. ولا تُحفظ أبداً في سجل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Editor, l’esborrany es queda a l’iPhone fins que s’envia o es tanca el teclat. Mai no es desa en cap historial."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I redigeringstilstand bliver kladden på iPhone, indtil den sendes, eller tastaturet lukkes. Den gemmes aldrig i en historik."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V režimu Editor zůstane koncept na iPhonu, dokud ho neodešlete nebo nezavřete klávesnici. Nikdy se neukládá do historie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη λειτουργία Επεξεργασίας, το πρόχειρο παραμένει στο iPhone μέχρι να σταλεί ή να κλείσει το πληκτρολόγιο. Δεν αποθηκεύεται ποτέ σε ιστορικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Editor, el borrador permanece en el iPhone hasta que se envía o se cierra el teclado. Nunca se guarda en un historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaustilassa luonnos säilyy iPhonessa, kunnes se lähetetään tai näppäimistö suljetaan. Sitä ei koskaan tallenneta historiaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במצב עורך, הטיוטה נשארת ב‑iPhone עד שהיא נשלחת או עד שהמקלדת נסגרת. היא לעולם אינה נשמרת בהיסטוריה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिटर मोड में ड्राफ़्ट भेजे जाने या कीबोर्ड बंद होने तक iPhone पर रहता है। इसे कभी इतिहास में सेव नहीं किया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U načinu Uređivač skica ostaje na iPhoneu dok se ne pošalje ili dok se tipkovnica ne zatvori. Nikada se ne sprema u povijest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerkesztő módban a piszkozat az iPhone-on marad, amíg el nem küldöd vagy be nem zárod a billentyűzetet. Soha nem kerül az előzményekbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mode Editor, draf tetap di iPhone sampai dikirim atau papan ketik ditutup. Draf tidak pernah disimpan dalam riwayat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità Editor, la bozza rimane sull’iPhone finché non viene inviata o la tastiera non si chiude. Non viene mai salvata in una cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタモードでは、送信するかキーボードを閉じるまで下書きがiPhoneに残ります。履歴には保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기 모드에서는 초안을 보내거나 키보드를 닫을 때까지 iPhone에 남아 있습니다. 기록에는 저장되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam mod Editor, draf kekal pada iPhone sehingga dihantar atau papan kekunci ditutup. Draf tidak pernah disimpan dalam sejarah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I redigeringsmodus blir utkastet på iPhonen til det sendes eller tastaturet lukkes. Det lagres aldri i en historikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de editormodus blijft het concept op de iPhone totdat het wordt verzonden of het toetsenbord sluit. Het wordt nooit in een geschiedenis bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie Edytora wersja robocza pozostaje na iPhonie do chwili wysłania lub zamknięcia klawiatury. Nigdy nie jest zapisywana w historii."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo Editor, o rascunho permanece no iPhone até ser enviado ou o teclado ser fechado. Ele nunca é salvo em um histórico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În modul Editor, ciorna rămâne pe iPhone până când este trimisă sau tastatura se închide. Nu este salvată niciodată într-un istoric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме редактора черновик остаётся на iPhone до отправки или закрытия клавиатуры. Он не сохраняется в истории."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V režime Editor zostane koncept na iPhone, kým ho neodošlete alebo nezavriete klávesnicu. Nikdy sa neukladá do histórie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I redigeringsläget stannar utkastet på iPhone tills det skickas eller tangentbordet stängs. Det sparas aldrig i någon historik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดตัวแก้ไข ข้อความร่างจะอยู่บน iPhone จนกว่าจะส่งหรือปิดแป้นพิมพ์ และจะไม่ถูกบันทึกในประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenleyici modunda taslak, gönderilene veya klavye kapanana kadar iPhone'da kalır. Hiçbir zaman geçmişe kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У режимі редактора чернетка залишається на iPhone, доки її не буде надіслано або клавіатуру не буде закрито. Вона ніколи не зберігається в історії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong chế độ Trình chỉnh sửa, bản nháp ở lại trên iPhone cho đến khi được gửi hoặc bàn phím đóng. Bản nháp không bao giờ được lưu vào lịch sử."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "喺編輯器模式，草稿會留喺 iPhone，直到傳送或者關閉鍵盤為止，而且永遠唔會儲存到歷史記錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在编辑器模式下，草稿会保留在 iPhone 上，直到发送或关闭键盘。草稿绝不会存入历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在編輯器模式下，草稿會保留在 iPhone 上，直到傳送或關閉鍵盤。草稿絕不會存入歷史記錄。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Correcteur, le brouillon reste sur l’iPhone jusqu’à son envoi ou la fermeture du clavier. Il n’est jamais enregistré dans un historique."
          }
        }
      }
    },
