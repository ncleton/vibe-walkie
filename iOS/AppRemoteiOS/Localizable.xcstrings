    "ios.workspace.configuration.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The control configuration is unreadable. Reset controls in Vibe Walkie settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration des commandes est illisible. Réinitialisez les commandes dans les réglages de Vibe Walkie."
          }
        }
      }
    },
    "ios.companion.computer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinateur"
          }
        }
      }
    },
    "ios.companion.system": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système"
          }
        }
      }
    },
    "ios.companion.install": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer un compagnon"
          }
        }
      }
    },
    "ios.companion.download": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the companion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger le compagnon"
          }
        }
      }
    },
    "ios.companion.installation.guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation guide"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide d’installation"
          }
        }
      }
    },
    "ios.companion.pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appairer votre iPhone"
          }
        }
      }
    },
    "ios.companion.mac.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and open Vibe Walkie on your Mac. Allow Accessibility and Screen Recording when requested."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez et ouvrez Vibe Walkie sur votre Mac. Autorisez l’Accessibilité et l’enregistrement de l’écran à sa demande."
          }
        }
      }
    },
    "ios.companion.windows.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract the download on your PC. Install Python 3.11 or later, then run Companion/scripts/install-windows.ps1 in PowerShell. Open the Vibe Walkie desktop shortcut in your unlocked session."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompressez le téléchargement sur votre PC. Installez Python 3.11 ou ultérieur, puis lancez Companion/scripts/install-windows.ps1 dans PowerShell. Ouvrez le raccourci Vibe Walkie dans votre session déverrouillée."
          }
        }
      }
    },
    "ios.companion.linux.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the Linux installation guide. An existing desktop needs X11. On a VPS without a screen, start the supplied virtual desktop; its terminal and applications appear on your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le guide d’installation Linux. Un bureau existant nécessite X11. Sur un VPS sans écran, lancez le bureau virtuel fourni : son terminal et ses applications apparaîtront sur l’iPhone."
          }
        }
      }
    },
    "ios.companion.mac.pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Pair an iPhone in the Mac companion to display its QR code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Appairer un iPhone dans le compagnon Mac pour afficher son QR code."
          }
        }
      }
    },
    "ios.companion.cli.pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the companion running, open a second terminal using the installed environment and generate its QR image:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compagnon étant démarré, ouvrez un second terminal avec l’environnement installé et générez son QR code :"
          }
        }
      }
    },
    "ios.companion.cli.approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After scanning, run vibewalkie pending on the computer, compare the six digits, then approve the request as described in the installation guide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le scan, lancez vibewalkie pending sur l’ordinateur, comparez les six chiffres, puis approuvez la demande comme indiqué dans le guide."
          }
        }
      }
    },
    "ios.companion.iphone.pairing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to Add a computer on this iPhone. Scan the QR, import its image or paste its private code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à Ajouter un ordinateur sur cet iPhone. Scannez le QR, importez son image ou collez son code privé."
          }
        }
      }
    },
    "ios.companion.remote.instructions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Away from the same local network, connect Tailscale on the iPhone and computer. Windows and Linux companions use the connected Tailscale address by default; the guide also explains local network setup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À distance, connectez Tailscale sur l’iPhone et l’ordinateur. Les compagnons Windows et Linux utilisent son adresse par défaut ; le guide explique aussi la connexion sur le réseau local."
          }
        }
      }
    }
  },
  "version": "1.0"
}
