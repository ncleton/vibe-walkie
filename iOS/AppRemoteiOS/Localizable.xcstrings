        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το iPhone δεν υποστηρίζει την απαιτούμενη μεταγραφή στη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no admite la transcripción local necesaria."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä iPhone ei tue vaadittua laitteessa tehtävää litterointia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה‑iPhone הזה אינו תומך בתמלול המקומי הנדרש."
