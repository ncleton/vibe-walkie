            "value": "掃描 Vibe Walkie 喺 Mac 顯示嘅代碼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描 Mac 上 Vibe Walkie 显示的代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描 Mac 上 Vibe Walkie 顯示的代碼。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code affiché par Vibe Walkie sur votre ordinateur."
          }
        }
      }
    },
