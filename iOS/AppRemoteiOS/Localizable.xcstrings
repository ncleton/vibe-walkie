    "ios.custom.shortcuts.and.icons.in.these.seven.positions.will.be.6fa78be": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom shortcuts and icons in these seven positions will be replaced."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Kurzbefehle und Symbole an diesen sieben Positionen werden ersetzt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استبدال الاختصارات والأيقونات المخصصة في هذه المواضع السبعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dreceres i les icones personalitzades d’aquestes set posicions se substituiran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede genveje og ikoner på disse syv placeringer bliver erstattet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní zkratky a ikony na těchto sedmi pozicích budou nahrazeny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσαρμοσμένες συντομεύσεις και τα εικονίδια σε αυτές τις επτά θέσεις θα αντικατασταθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos y iconos personalizados en estas siete posiciones serán reemplazados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näiden seitsemän paikan mukautetut pikakomennot ja kuvakkeet korvataan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי הדרך והסמלים המותאמים אישית בשבעת המיקומים האלה יוחלפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन सात जगहों के कस्टम शॉर्टकट और आइकन बदल दिए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagođeni prečaci i ikone na ovih sedam položaja bit će zamijenjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ezen a hét helyen lévő egyéni parancsikonok és ikonok lecserélődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan khusus dan ikon di tujuh posisi ini akan diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie personalizzate e le icone in queste sette posizioni saranno sostituite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この7か所に設定したカスタムショートカットとアイコンは置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 7개 위치의 사용자 설정 단축키와 아이콘이 교체됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan dan ikon tersuai di tujuh kedudukan ini akan digantikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpassede snarveier og ikoner på disse syv plasseringene blir erstattet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste sneltoetsen en pictogrammen op deze zeven posities worden vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niestandardowe skróty i ikony w tych siedmiu pozycjach zostaną zastąpione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos personalizados e os ícones nestas sete posições serão substituídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurtăturile și pictogramele personalizate din aceste șapte poziții vor fi înlocuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские сочетания клавиш и значки в этих семи позициях будут заменены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastné skratky a ikony na týchto siedmich pozíciách budú nahradené."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassade genvägar och ikoner på dessa sju platser kommer att ersättas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดและไอคอนแบบกำหนดเองในทั้งเจ็ดตำแหน่งนี้จะถูกแทนที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedi konumdaki özel kısayollar ve simgeler değiştirilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власні команди та значки в цих семи позиціях буде замінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt và biểu tượng tùy chỉnh ở bảy vị trí này sẽ bị thay thế."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢七個位置嘅自訂快捷鍵同圖示將會被取代。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这七个位置中的自定义快捷键和图标将被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這七個位置中的自訂快速鍵和圖示將被替換。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis et icônes personnalisés de ces sept zones seront remplacés."
          }
        }
      }
    },
