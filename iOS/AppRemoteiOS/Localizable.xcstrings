            "value": "Innsettingen ble ikke bekreftet. Kontroller det aktive feltet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoegen niet bevestigd. Controleer het actieve veld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstawienie nie zostało potwierdzone. Sprawdź aktywne pole."
          }
        },
        "pt": {
          "stringUnit": {
