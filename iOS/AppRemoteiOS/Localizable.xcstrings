    "ios.changes.sync.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes will be sent to the computer the next time it connects."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements seront envoyés à l’ordinateur à la prochaine connexion."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُرسل التغييرات إلى Mac في المرة التالية التي يتصل فيها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els canvis s’enviaran al Mac la pròxima vegada que es connecti."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se odešlou do Macu při příštím připojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringerne sendes til Mac, næste gang den opretter forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderungen werden beim nächsten Verbinden an den Mac gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αλλαγές θα σταλούν στο Mac την επόμενη φορά που θα συνδεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios serán enviados al Mac la próxima vez que se conecte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset lähetetään Maciin seuraavan yhteyden muodostamisen yhteydessä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים יישלחו ל‑Mac בפעם הבאה שיתחבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार कनेक्ट होने पर बदलाव Mac को भेजे जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene će se poslati na Mac pri sljedećem povezivanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításokat a következő kapcsolódáskor küldjük el a Macre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan akan dikirim ke Mac saat berikutnya tersambung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche verranno inviate al Mac la prossima volta che si connette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回Macに接続したときに変更が送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 연결되면 변경 사항이 Mac으로 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan akan dihantar ke Mac apabila ia bersambung semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringene sendes til Macen neste gang den kobler til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen worden naar de Mac gestuurd wanneer deze weer verbinding maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zostaną wysłane do Maca przy następnym połączeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações serão enviadas ao Mac da próxima vez que se conectar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările vor fi trimise la Mac data viitoare când se conectează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
