    "ios.hold.the.handle.then.drag.35697e0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the handle, then drag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Griff gedrückt halten und ziehen"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولاً على المقبض، ثم اسحب"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut l’agafador i arrossega"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold i håndtaget, og træk"
          }
        },
        "cs": {
          "stringUnit": {
