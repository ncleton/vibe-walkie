            "value": "Den här maskinvarugenvägen kan ersättas från Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถแทนที่ปุ่มลัดฮาร์ดแวร์นี้จาก Mac ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu donanım kısayolu Mac'ten değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю апаратну команду можна замінити на Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể thay phím tắt phần cứng này từ Mac."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "可以喺 Mac 取代呢個硬件快捷鍵。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在 Mac 上替换此硬件快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在 Mac 上替換此硬體快速鍵。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci matériel peut être remplacé depuis l’ordinateur."
          }
        }
      }
    },
    "ios.this.iphone.does.not.support.the.required.on.device.transcription.ab659af": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone does not support the required on-device transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone unterstützt die erforderliche Transkription auf dem Gerät nicht."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ iPhone لا يدعم تحويل الكلام إلى نص المطلوب على الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest iPhone no admet la transcripció necessària al dispositiu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone understøtter ikke den nødvendige transskribering på enheden."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone nepodporuje požadovaný přepis v zařízení."
