    "ios.tap.a.mac.to.switch.the.remote.each.companion.must.51a9305": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a computer to switch the remote. Each companion must be paired once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Mac, um die Fernbedienung zu wechseln. Jede Begleitapp muss einmal gekoppelt werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على جهاز Mac لتبديل جهاز التحكم. يجب إقران كل تطبيق مصاحب مرة واحدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un Mac per canviar el comandament. Cada app complementària s’ha d’enllaçar una vegada."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en Mac for at skifte fjernbetjening. Hver hjælpeapp skal kun parres én gang."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na Mac přepnete ovladač. Každou doprovodnou aplikaci je třeba jednou spárovat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε ένα Mac για να αλλάξετε τηλεχειριστήριο. Κάθε συνοδευτική εφαρμογή πρέπει να συζευχθεί μία φορά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un Mac para cambiar el control remoto. Cada app complementaria debe emparejarse una vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda kaukosäädintä napauttamalla Macia. Jokaisesta apuapista on muodostettava laitepari kerran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על Mac כדי להעביר אליו את השלט. יש לקשר כל יישום נלווה פעם אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट बदलने के लिए किसी Mac पर टैप करें। हर सहायक ऐप को एक बार पेयर करना होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite Mac kako biste prebacili daljinski upravljač. Svaku prateću aplikaciju treba jednom upariti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy Macre a távirányító átváltásához. Minden kísérőalkalmazást egyszer kell párosítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Mac untuk mengganti remote. Setiap app pendamping cukup dipasangkan sekali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un Mac per cambiare il telecomando. Ogni app complementare deve essere abbinata una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macをタップして操作先を切り替えます。各コンパニオンは一度ペアリングする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 탭하여 제어 대상을 전환하세요. 각 컴패니언은 한 번씩 페어링해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik Mac untuk menukar alat kawalan jauh. Setiap aplikasi pendamping perlu dipasangkan sekali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en Mac for å bytte fjernkontroll. Hver hjelpeapp må bare kobles sammen én gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een Mac om de afstandsbediening te wisselen. Elke hulpapp hoeft maar één keer te worden gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Maca, aby przełączyć pilota. Każdą aplikację pomocniczą trzeba sparować tylko raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um Mac para trocar o controle remoto. Cada app complementar precisa ser emparelhado uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un Mac pentru a comuta telecomanda. Fiecare aplicație companion trebuie asociată o singură dată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Mac, чтобы переключить пульт. Каждое приложение-компаньон нужно связать один раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na Mac prepnete ovládač. Každú sprievodnú aplikáciu treba raz spárovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en Mac för att byta fjärrkontroll. Varje hjälpapp behöver bara parkopplas en gång."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ Mac เพื่อสลับรีโมต แอปคู่หูแต่ละเครื่องต้องจับคู่หนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaktan kumandayı değiştirmek için bir Mac'e dokunun. Her yardımcı uygulamanın yalnızca bir kez eşleştirilmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться Mac, щоб перемкнути пульт. Кожну програму-компаньйон потрібно спарити один раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào Mac để chuyển bộ điều khiển. Mỗi ứng dụng đồng hành chỉ cần ghép đôi một lần."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "撳一部 Mac 就可以切換遙控器。每個輔助 App 都要配對一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一台 Mac 即可切换遥控器。每个配套 App 只需配对一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一台 Mac 即可切換遙控器。每個輔助 App 只需配對一次。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un ordinateur pour basculer la télécommande. Chaque compagnon doit être appairé une fois."
          }
        }
      }
    },
    "ios.tap.a.position.to.choose.its.key.name.and.icon.c579601": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a position to choose its key, name, and icon. The Push-to-Talk button always stays in the center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Position, um Taste, Namen und Symbol auszuwählen. Die Push-to-Talk-Taste bleibt immer in der Mitte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على موضع لاختيار مفتاحه واسمه وأيقونته. يبقى زر Push-to-Talk دائماً في الوسط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una posició per triar-ne la tecla, el nom i la icona. El botó Push-to-Talk sempre es queda al centre."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en placering for at vælge tast, navn og ikon. Push-to-Talk-knappen bliver altid i midten."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na pozici vyberte klávesu, název a ikonu. Tlačítko Push-to-Talk vždy zůstává uprostřed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε μια θέση για να επιλέξετε το πλήκτρο, το όνομα και το εικονίδιό της. Το κουμπί Push-to-Talk παραμένει πάντα στο κέντρο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una posición para elegir su tecla, nombre e icono. El botón Push-to-Talk permanece siempre en el centro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse paikan näppäin, nimi ja kuvake napauttamalla sitä. Push-to-Talk-painike pysyy aina keskellä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על מיקום כדי לבחור את המקש, השם והסמל שלו. כפתור ה‑Push-to-Talk נשאר תמיד במרכז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी, नाम और आइकन चुनने के लिए किसी जगह पर टैप करें। Push-to-Talk बटन हमेशा बीच में रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite položaj kako biste odabrali njegovu tipku, naziv i ikonu. Gumb Push-to-Talk uvijek ostaje u sredini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy pozícióra a billentyű, a név és az ikon kiválasztásához. A Push-to-Talk gomb mindig középen marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk posisi untuk memilih tombol, nama, dan ikonnya. Tombol Push-to-Talk selalu berada di tengah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una posizione per scegliere tasto, nome e icona. Il pulsante Push-to-Talk rimane sempre al centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置をタップしてキー、名前、アイコンを選択します。Push-to-Talkボタンは常に中央に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 탭하여 키, 이름, 아이콘을 선택하세요. Push-to-Talk 버튼은 항상 가운데에 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kedudukan untuk memilih kekunci, nama dan ikonnya. Butang Push-to-Talk sentiasa kekal di tengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en plassering for å velge tast, navn og ikon. Push-to-Talk-knappen blir alltid i midten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een positie om de toets, naam en het pictogram te kiezen. De Push-to-Talk-knop blijft altijd in het midden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij pozycję, aby wybrać klawisz, nazwę i ikonę. Przycisk Push-to-Talk zawsze pozostaje na środku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma posição para escolher tecla, nome e ícone. O botão Push-to-Talk permanece sempre no centro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge o poziție pentru a-i alege tasta, numele și pictograma. Butonul Push-to-Talk rămâne întotdeauna în centru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите позицию, чтобы выбрать клавишу, название и значок. Кнопка Push-to-Talk всегда остаётся в центре."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na pozíciu vyberte kláves, názov a ikonu. Tlačidlo Push-to-Talk zostáva vždy v strede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en position för att välja tangent, namn och ikon. Push-to-Talk-knappen stannar alltid i mitten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะตำแหน่งเพื่อเลือกปุ่ม ชื่อ และไอคอน ปุ่ม Push-to-Talk จะอยู่ตรงกลางเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuşu, adı ve simgeyi seçmek için bir konuma dokunun. Push-to-Talk düğmesi her zaman ortada kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться позиції, щоб вибрати клавішу, назву та значок. Кнопка Push-to-Talk завжди залишається в центрі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một vị trí để chọn phím, tên và biểu tượng. Nút Push-to-Talk luôn ở giữa."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "撳一個位置嚟揀按鍵、名稱同圖示。Push-to-Talk 按鈕會一直留喺中間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一个位置以选择按键、名称和图标。按住说话按钮始终位于中央。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點一個位置以選擇按鍵、名稱和圖示。按住說話按鈕始終位於中央。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une zone pour choisir sa touche, son nom et son icône. Le bouton Push‑to‑Talk reste toujours au centre."
          }
        }
      }
    },
