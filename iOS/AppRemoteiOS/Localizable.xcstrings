    "ios.health.connected.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized steps, distance, and exercise minutes are combined by HealthKit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pas, la distance et les minutes d’exercice autorisés sont fusionnés par HealthKit"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدمج الخطوات والمسافة ودقائق التمرين المسموح بها عبر HealthKit"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit combina els passos autoritzats, la distància i els minuts d'exercici"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizované kroky, vzdálenost a minuty cvičení jsou kombinovány pomocí HealthKit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriserede skridt, distance og træningsminutter kombineres af HealthKit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisierte Schritte, Distanz und Trainingsminuten werden von HealthKit kombiniert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εξουσιοδοτημένα βήματα, η απόσταση και τα λεπτά άσκησης συνδυάζονται από το HealthKit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos, la distancia y los minutos de ejercicio autorizados se combinan con HealthKit"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit yhdistää sallitut askeleet, matkan ja harjoitusminuutit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעדים, המרחק ודקות האימון שאושרו משולבים באמצעות HealthKit"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकृत कदम, दूरी और व्यायाम मिनट को HealthKit द्वारा संयोजित किया जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odobrene korake, udaljenost i minute vježbanja kombinira HealthKit"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyezett lépéseket, távolságot és edzésperceket a(z) HealthKit kombinálja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah resmi, jarak, dan menit latihan digabungkan dengan HealthKit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passi autorizzati, distanza e minuti di allenamento vengono combinati da HealthKit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可された歩数、距離、エクササイズ時間をHealthKitで統合します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 걸음 수, 거리, 운동 시간은 HealthKit로 결합됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah, jarak dan minit senaman yang dibenarkan digabungkan oleh HealthKit"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriserte skritt, distanse og treningsminutter kombineres av HealthKit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geautoriseerde stappen, afstand en trainingsminuten worden gecombineerd door HealthKit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoryzowane kroki, dystans i minuty ćwiczeń są łączone przez HealthKit"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos, distância e minutos de exercício autorizados são combinados por HealthKit"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pașii autorizați, distanța și minutele de exercițiu sunt combinate de HealthKit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешенные шаги, расстояние и минуты тренировок объединяются с помощью HealthKit."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizované kroky, vzdialenosť a minúty cvičenia sú kombinované pomocou súpravy HealthKit"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkända steg, distans och träningsminuter kombineras av HealthKit"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนก้าว ระยะทาง และนาทีการออกกำลังกายที่ได้รับอนุญาตจะรวมกันโดย HealthKit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verilen adımlar, mesafe ve egzersiz dakikaları HealthKit ile birleştirilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволені кроки, відстань і хвилини вправ поєднуються HealthKit"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số bước, khoảng cách và số phút tập thể dục được cho phép được tổng hợp bởi HealthKit"
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "授權步數、距離同運動分鐘由 HealthKit 合併"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权的步数、距离和锻炼分钟数会通过HealthKit合并"
          }
        },
        "zh-Hant": {
