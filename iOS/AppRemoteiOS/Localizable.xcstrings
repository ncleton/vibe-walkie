    "premium.renewal.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled at least 24 hours before the end of the current period."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجديد الاشتراكات تلقائيًا ما لم يتم إلغاؤها قبل 24 ساعة على الأقل من نهاية الفترة الحالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les subscripcions es renoven automàticament tret que es cancel·lin almenys 24 hores abans del final del període actual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné se automaticky obnovuje, pokud není zrušeno alespoň 24 hodin před koncem aktuálního období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før udgangen af ​​den aktuelle periode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums gekündigt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνδρομές ανανεώνονται αυτόματα εκτός εάν ακυρωθούν τουλάχιστον 24 ώρες πριν από το τέλος της τρέχουσας περιόδου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente a menos que se cancelen al menos 24 horas antes del final del período actual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaukset uusiutuvat automaattisesti, ellei niitä peruuteta vähintään 24 tuntia ennen nykyisen jakson päättymistä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנויים מתחדשים אוטומטית אלא אם בוטלו לפחות 24 שעות לפני תום התקופה הנוכחית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान अवधि के अंत से कम से कम 24 घंटे पहले रद्द किए जाने तक सदस्यताएँ स्वचालित रूप से नवीनीकृत हो जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretplate se automatski obnavljaju osim ako se ne otkažu najmanje 24 sata prije kraja tekućeg razdoblja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetések automatikusan megújulnak, hacsak nem mondják le legalább 24 órával az aktuális időszak vége előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang secara otomatis kecuali dibatalkan setidaknya 24 jam sebelum akhir periode berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti si rinnovano automaticamente a meno che non vengano annullati almeno 24 ore prima della fine del periodo corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の期間が終了する少なくとも 24 時間前にキャンセルしない限り、サブスクリプションは自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기간이 종료되기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tamat tempoh semasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementer fornyes automatisk med mindre de kanselleres minst 24 timer før slutten av gjeldende periode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementen worden automatisch verlengd, tenzij ze ten minste 24 uur voor het einde van de huidige periode worden opgezegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane co najmniej 24 godziny przed końcem bieżącego okresu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do final do período atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonamentele se reînnoiesc automat, cu excepția cazului în care sunt anulate cu cel puțin 24 de ore înainte de sfârșitul perioadei curente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически, если они не отменены по крайней мере за 24 часа до окончания текущего периода."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predplatné sa automaticky obnoví, pokiaľ nebude zrušené aspoň 24 hodín pred koncom aktuálneho obdobia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationer förnyas automatiskt om de inte avbryts minst 24 timmar före slutet av den aktuella perioden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะต่ออายุโดยอัตโนมัติเว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดช่วงเวลาปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler, cari dönemin bitiminden en az 24 saat önce iptal edilmediği sürece otomatik olarak yenilenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки поновлюються автоматично, якщо їх не скасовано принаймні за 24 години до закінчення поточного періоду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký tự động gia hạn trừ khi bị hủy ít nhất 24 giờ trước khi kết thúc giai đoạn hiện tại."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "除非喺當前期限結束前至少24小時取消，否則訂閱會自動續訂。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订，除非在当前订阅期结束前至少 24 小时取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會自動續訂，除非在目前訂閱期結束前至少 24 小時取消。"
          }
        }
      }
    },
