    "ios.move.the.pointer.click.scroll.and.drag.395a9bc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the pointer, click, scroll, and drag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger bewegen, klicken, scrollen und ziehen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك المؤشر وانقر ومرّر واسحب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou el punter, fes clic, desplaça’t i arrossega."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt markøren, klik, rul og træk."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohybujte ukazatelem, klikejte, posouvejte a přetahujte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινήστε τον δείκτη, κάντε κλικ, κύλιση και μεταφορά."
          }
