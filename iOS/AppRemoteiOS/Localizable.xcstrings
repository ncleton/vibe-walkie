    "ios.the.clipboard.changed.in.the.meantime.so.it.was.not.939ce66": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard changed in the meantime, so it was not restored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage wurde inzwischen geändert und deshalb nicht wiederhergestellt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت الحافظة في هذه الأثناء، لذلك لم تتم استعادتها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El porta-retalls ha canviat mentrestant i, per tant, no s’ha restaurat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udklipsholderen blev ændret i mellemtiden og blev derfor ikke gendannet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka se mezitím změnila, takže nebyla obnovena."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρόχειρο άλλαξε στο μεταξύ, οπότε δεν επαναφέρθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles cambió mientras tanto, por lo que no se restauró."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leikepöytä muuttui sillä välin, joten sitä ei palautettu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלוח השתנה בינתיים ולכן לא שוחזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बीच क्लिपबोर्ड बदल गया, इसलिए उसे वापस नहीं लाया गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Međuspremnik se u međuvremenu promijenio pa nije vraćen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vágólap időközben megváltozott, ezért nem lett visszaállítva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan klip berubah sementara itu, sehingga tidak dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel frattempo gli appunti sono cambiati, quindi non sono stati ripristinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その間にクリップボードが変更されたため、元に戻しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그동안 클립보드가 변경되어 복원하지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan klip berubah sementara itu, jadi ia tidak dipulihkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utklippstavlen ble endret i mellomtiden og ble derfor ikke gjenopprettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het klembord is intussen gewijzigd en daarom niet hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schowek zmienił się w międzyczasie, dlatego nie został przywrócony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência mudou nesse meio-tempo e, por isso, não foi restaurada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipboardul s-a schimbat între timp, așa că nu a fost restaurat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена изменился, поэтому восстановление не выполнено."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Schránka sa medzitým zmenila, takže nebola obnovená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Urklipp ändrades under tiden och återställdes därför inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิปบอร์ดมีการเปลี่ยนแปลง จึงไม่ได้คืนค่าเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sırada pano değiştiği için geri yüklenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тим часом буфер обміну змінився, тому його не було відновлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng nhớ tạm đã thay đổi nên không được khôi phục."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿期間有變更，所以冇還原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板内容已在此期间更改，因此未恢复原内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿內容已在此期間變更，因此未恢復原內容。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse-papiers modifié entre-temps : restauration abandonnée."
          }
        }
      }
    },
    "ios.the.code.stays.between.your.devices.it.is.never.opened.766e735": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code stays between your devices. It is never opened in a browser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code bleibt zwischen deinen Geräten. Er wird nie in einem Browser geöffnet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الرمز بين أجهزتك ولا يُفتح مطلقاً في متصفح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El codi es queda entre els teus dispositius. Mai no s’obre en un navegador."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden bliver mellem dine enheder og åbnes aldrig i en browser."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód zůstává mezi vašimi zařízeními. Nikdy se neotevírá v prohlížeči."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός παραμένει μεταξύ των συσκευών σας. Δεν ανοίγει ποτέ σε πρόγραμμα περιήγησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código permanece entre tus dispositivos. Nunca se abre en un navegador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi pysyy laitteidesi välillä. Sitä ei koskaan avata selaimessa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד נשאר בין המכשירים שלכם. הוא לעולם אינו נפתח בדפדפן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड आपके डिवाइसों के बीच ही रहता है। इसे कभी ब्राउज़र में नहीं खोला जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kôd ostaje između vaših uređaja. Nikada se ne otvara u pregledniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kód az eszközeid között marad. Soha nem nyílik meg böngészőben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode hanya berada di antara perangkat Anda dan tidak pernah dibuka di browser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice rimane tra i tuoi dispositivi. Non viene mai aperto in un browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはデバイス間だけで使用され、ブラウザで開かれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 기기 간에만 사용되며 브라우저에서 열리지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod kekal antara peranti anda. Kod tidak pernah dibuka dalam pelayar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden blir mellom enhetene dine og åpnes aldri i en nettleser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code blijft tussen je apparaten en wordt nooit in een browser geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod pozostaje między urządzeniami i nigdy nie jest otwierany w przeglądarce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O código permanece entre seus dispositivos. Ele nunca é aberto em um navegador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul rămâne între dispozitivele tale. Nu este deschis niciodată într-un browser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код используется только между вашими устройствами и не открывается в браузере."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kód zostáva medzi vašimi zariadeniami. Nikdy sa neotvára v prehliadači."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden stannar mellan dina enheter och öppnas aldrig i en webbläsare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสจะอยู่ระหว่างอุปกรณ์ของคุณเท่านั้น และจะไม่ถูกเปิดในเบราว์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yalnızca cihazlarınız arasında kalır ve hiçbir zaman tarayıcıda açılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код залишається між вашими пристроями й ніколи не відкривається в браузері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã chỉ nằm giữa các thiết bị của bạn và không bao giờ được mở trong trình duyệt."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼只會留喺你嘅裝置之間，唔會喺瀏覽器開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码仅在你的设备之间传递，绝不会在浏览器中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼僅在你的裝置之間傳遞，絕不會在瀏覽器中開啟。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code reste entre vos appareils. Il n’est jamais ouvert dans un navigateur."
          }
        }
      }
    },
    "ios.the.connection.remains.direct.to.the.mac.no.account.tailscale.246dd09": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection remains direct to the computer. No account, Tailscale token, or persistent secret is sent to Vibe Walkie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung bleibt direkt zum Mac. Weder Konto noch Tailscale-Token oder dauerhaftes Geheimnis werden an Vibe Walkie gesendet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الاتصال مباشراً مع Mac. لا تُرسل إلى Vibe Walkie أي بيانات حساب أو رمز Tailscale أو سر دائم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexió continua sent directa amb el Mac. No s’envia a Vibe Walkie cap compte, testimoni de Tailscale ni secret persistent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen forbliver direkte til Mac. Ingen kontooplysninger, Tailscale-token eller varige hemmeligheder sendes til Vibe Walkie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení zůstává přímé k Macu. Do Vibe Walkie se neposílá žádný účet, token Tailscale ani trvalé tajemství."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση παραμένει απευθείας με το Mac. Δεν αποστέλλεται στο Vibe Walkie λογαριασμός, διακριτικό Tailscale ή μόνιμο μυστικό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión sigue siendo directa con el Mac. Vibe Walkie no recibe ninguna cuenta, token de Tailscale ni secreto persistente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys säilyy suorana Maciin. Vibe Walkielle ei lähetetä tiliä, Tailscale-tokenia eikä pysyvää salaisuutta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור ל‑Mac נשאר ישיר. שום חשבון, אסימון Tailscale או סוד קבוע אינם נשלחים אל Vibe Walkie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन सीधे Mac से बना रहता है। Vibe Walkie को कोई अकाउंट जानकारी, Tailscale टोकन या स्थायी सीक्रेट नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza s Macom ostaje izravna. Aplikaciji Vibe Walkie ne šalju se račun, Tailscale token ni trajna tajna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolat közvetlen marad a Mackel. Sem fiókot, sem Tailscale-tokent, sem tartós titkot nem küldünk a Vibe Walkie-nak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi tetap langsung ke Mac. Tidak ada akun, token Tailscale, atau data rahasia permanen yang dikirim ke Vibe Walkie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione rimane diretta al Mac. Nessun account, token Tailscale o segreto persistente viene inviato a Vibe Walkie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへの接続は常に直接行われます。アカウント、Tailscaleトークン、永続的なシークレットがVibe Walkieに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 계속 직접 연결됩니다. 계정, Tailscale 토큰, 영구 보안 정보는 Vibe Walkie로 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan kekal terus ke Mac. Tiada akaun, token Tailscale atau rahsia kekal dihantar kepada Vibe Walkie."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen forblir direkte til Macen. Ingen kontoinformasjon, Tailscale-token eller varige hemmeligheter sendes til Vibe Walkie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding blijft rechtstreeks met de Mac. Er worden geen accountgegevens, Tailscale-token of permanent geheim naar Vibe Walkie gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie pozostaje bezpośrednie z Makiem. Do Vibe Walkie nie są wysyłane żadne konto, token Tailscale ani trwały sekret."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão permanece direta com o Mac. Nenhuma conta, token do Tailscale ou segredo persistente é enviado ao Vibe Walkie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea rămâne directă cu Mac-ul. Niciun cont, token Tailscale sau secret persistent nu este trimis la Vibe Walkie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к Mac остаётся прямым. Учётная запись, токен Tailscale и постоянные секреты не передаются Vibe Walkie."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie zostáva priame k Macu. Do Vibe Walkie sa neposiela žiadny účet, token Tailscale ani trvalý tajný údaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen förblir direkt till Mac. Inga kontouppgifter, Tailscale-token eller beständiga hemligheter skickas till Vibe Walkie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อยังคงตรงไปยัง Mac ไม่มีการส่งบัญชี โทเค็น Tailscale หรือข้อมูลลับถาวรไปยัง Vibe Walkie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı doğrudan Mac'e yapılır. Vibe Walkie'ye hesap, Tailscale belirteci veya kalıcı gizli veri gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключення залишається прямим до Mac. Жодні дані облікового запису, токен Tailscale чи постійний секрет не надсилаються до Vibe Walkie."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối vẫn trực tiếp đến Mac. Không có tài khoản, mã thông báo Tailscale hay bí mật lâu dài nào được gửi đến Vibe Walkie."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "連接會保持直達 Mac。Vibe Walkie 唔會收到任何帳戶、Tailscale 權杖或者永久密鑰。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接始终直接通往 Mac。不会向 Vibe Walkie 发送账户、Tailscale 令牌或永久密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線始終直接通往 Mac。不會向 Vibe Walkie 傳送帳號、Tailscale 權杖或永久金鑰。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion reste directe vers l’ordinateur. Aucun compte, jeton Tailscale ou secret durable n’est transmis à Vibe Walkie."
          }
        }
      }
    },
