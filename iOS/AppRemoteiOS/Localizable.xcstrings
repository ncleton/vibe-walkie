    "ios.vibe.walkie.always.tries.the.local.network.first.then.tailscale.09b2bf5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie always tries the local network first, then Tailscale after 750 ms if needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie versucht immer zuerst das lokale Netzwerk und wechselt bei Bedarf nach 750 ms zu Tailscale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحاول Vibe Walkie الاتصال عبر الشبكة المحلية أولاً، ثم عبر Tailscale بعد 750 مللي ثانية عند الحاجة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie sempre prova primer la xarxa local i, si cal, Tailscale al cap de 750 ms."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie prøver altid først det lokale netværk og derefter Tailscale efter 750 ms, hvis det er nødvendigt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie vždy nejdřív zkusí místní síť a v případě potřeby po 750 ms Tailscale."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vibe Walkie δοκιμάζει πάντα πρώτα το τοπικό δίκτυο και, αν χρειαστεί, το Tailscale μετά από 750 ms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie prueba siempre primero la red local y, si hace falta, Tailscale después de 750 ms."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie kokeilee aina ensin paikallisverkkoa ja tarvittaessa Tailscalea 750 ms:n kuluttua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie מנסה תמיד תחילה את הרשת המקומית, ואם צריך עובר ל‑Tailscale לאחר 750 אלפיות השנייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie पहले लोकल नेटवर्क आज़माता है और ज़रूरत होने पर 750 मिलीसेकंड बाद Tailscale आज़माता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie uvijek prvo pokušava putem lokalne mreže, a zatim po potrebi putem Tailscalea nakon 750 ms."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vibe Walkie mindig először a helyi hálózatot próbálja, majd szükség esetén 750 ms után a Tailscale-t."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie selalu mencoba jaringan lokal terlebih dahulu, kemudian Tailscale setelah 750 ms jika diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie prova sempre prima la rete locale, poi Tailscale dopo 750 ms se necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkieは最初にローカルネットワークへの接続を試し、必要な場合は750ミリ秒後にTailscaleへ切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie는 먼저 로컬 네트워크 연결을 시도하고, 필요한 경우 750ms 후 Tailscale을 시도합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie sentiasa mencuba rangkaian setempat dahulu, kemudian Tailscale selepas 750 ms jika perlu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie prøver alltid det lokale nettverket først og deretter Tailscale etter 750 ms ved behov."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie probeert altijd eerst het lokale netwerk en zo nodig na 750 ms Tailscale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie zawsze sprawdza sieć lokalną, a następnie Tailscale po 750 ms, jeśli jest to konieczne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vibe Walkie sempre tenta primeiro a rede local e, após 750 ms, usa o Tailscale se necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie încearcă întotdeauna mai întâi rețeaua locală, apoi Tailscale după 750 ms, dacă este necesar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie сначала пробует локальную сеть, а при необходимости через 750 мс — Tailscale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie vždy najprv skúsi miestnu sieť a v prípade potreby po 750 ms Tailscale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie provar alltid det lokala nätverket först och därefter Tailscale efter 750 ms om det behövs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie จะลองเครือข่ายภายในก่อนเสมอ แล้วจึงลอง Tailscale หลัง 750 มิลลิวินาทีหากจำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie her zaman önce yerel ağı, gerekirse 750 ms sonra Tailscale'i dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie завжди спочатку пробує локальну мережу, а за потреби через 750 мс — Tailscale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie luôn thử mạng cục bộ trước, sau đó thử Tailscale sau 750 ms nếu cần."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 會先嘗試本機網絡，有需要先會喺 750 毫秒後使用 Tailscale。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 始终先尝试本地网络；如有需要，会在 750 毫秒后尝试 Tailscale。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 始終先嘗試區域網路；如有需要，會在 750 毫秒後嘗試 Tailscale。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie essaie toujours le réseau local en premier, puis Tailscale après 750 ms si nécessaire."
          }
        }
      }
    },
    "ios.vibe.walkie.never.inserts.dictation.into.a.secure.field.bac6c18": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie never inserts dictation into a secure field."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie fügt niemals diktierten Text in ein geschütztes Feld ein."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُدخل Vibe Walkie نص الإملاء أبداً في حقل آمن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie no insereix mai text dictat en un camp segur."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie indsætter aldrig dikteret tekst i et sikkert felt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nikdy nevkládá diktovaný text do zabezpečeného pole."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vibe Walkie δεν εισάγει ποτέ υπαγορευμένο κείμενο σε ασφαλές πεδίο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nunca inserta texto dictado en un campo protegido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie ei koskaan lisää sanelua suojattuun kenttään."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie לעולם אינו מזין הכתבה בשדה מאובטח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie कभी सुरक्षित फ़ील्ड में डिक्टेशन का टेक्स्ट नहीं डालता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nikada ne umeće diktat u sigurno polje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vibe Walkie soha nem szúr be diktált szöveget biztonságos mezőbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie tidak pernah memasukkan hasil dikte ke kolom aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie non inserisce mai la dettatura in un campo protetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkieが安全なフィールドに音声入力のテキストを挿入することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie는 보안 필드에 받아쓰기 텍스트를 입력하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie tidak pernah memasukkan imlak ke dalam medan selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie setter aldri diktert tekst inn i et sikkert felt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie voegt dicteertekst nooit in een beveiligd veld in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nigdy nie wstawia dyktowanego tekstu do bezpiecznego pola."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vibe Walkie nunca insere texto ditado num campo seguro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nu introduce niciodată dictarea într-un câmp securizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie никогда не вставляет текст диктовки в защищённое поле."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie nikdy nevkladá diktovaný text do zabezpečeného poľa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie infogar aldrig dikterad text i ett säkert fält."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie จะไม่ใส่ข้อความจากการป้อนตามคำบอกในช่องที่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie dikte edilen metni hiçbir zaman güvenli bir alana eklemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie ніколи не вставляє продиктований текст у захищене поле."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie không bao giờ chèn văn bản đọc chính tả vào trường bảo mật."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 永遠唔會將聽寫文字輸入安全欄位。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 绝不会将听写文本输入安全文本栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie 絕不會將聽寫文字輸入安全文字欄位。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie n'insère jamais de dictée dans un champ sécurisé."
          }
        }
      }
    },
