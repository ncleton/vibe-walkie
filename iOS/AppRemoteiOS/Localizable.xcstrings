    "ios.screen.view.stays.encrypted.between.iphone.and.mac.and.adapts.5eedf76": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen view stays encrypted between iPhone and computer and adapts to network quality. The PTT button is on the right by default and can be moved to the left."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmansicht bleibt zwischen iPhone und Mac verschlüsselt und passt sich an die Netzwerkqualität an. Die PTT-Taste befindet sich standardmäßig rechts und kann nach links verschoben werden."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى عرض الشاشة مشفّراً بين iPhone وMac ويتكيف مع جودة الشبكة. يظهر زر PTT على اليمين افتراضياً ويمكن نقله إلى اليسار."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista de la pantalla es manté xifrada entre l’iPhone i el Mac i s’adapta a la qualitat de la xarxa. El botó PTT és a la dreta per defecte i es pot moure a l’esquerra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmvisningen forbliver krypteret mellem iPhone og Mac og tilpasser sig netværkskvaliteten. PTT-knappen er som standard til højre, men kan flyttes til venstre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazení obrazovky zůstává mezi iPhonem a Macem šifrované a přizpůsobuje se kvalitě sítě. Tlačítko PTT je ve výchozím nastavení vpravo a lze ho přesunout doleva."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προβολή οθόνης παραμένει κρυπτογραφημένη μεταξύ iPhone και Mac και προσαρμόζεται στην ποιότητα του δικτύου. Το κουμπί PTT βρίσκεται δεξιά από προεπιλογή και μπορεί να μετακινηθεί αριστερά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista de pantalla permanece cifrada entre el iPhone y el Mac y se adapta a la calidad de la red. El botón PTT está a la derecha de forma predeterminada y puede moverse a la izquierda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttönäkymä pysyy salattuna iPhonen ja Macin välillä ja mukautuu verkon laatuun. PTT-painike on oletuksena oikealla, mutta sen voi siirtää vasemmalle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגת המסך נשארת מוצפנת בין ה‑iPhone ל‑Mac ומתאימה את עצמה לאיכות הרשת. כפתור PTT נמצא מימין כברירת מחדל ואפשר להעבירו שמאלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन व्यू iPhone और Mac के बीच एन्क्रिप्टेड रहता है और नेटवर्क की क्वालिटी के अनुसार ढलता है। PTT बटन डिफ़ॉल्ट रूप से दाईं ओर रहता है और इसे बाईं ओर ले जाया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaz zaslona ostaje šifriran između iPhonea i Maca te se prilagođava kvaliteti mreže. Gumb PTT prema zadanim je postavkama desno i može se premjestiti lijevo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyőnézet titkosítva marad az iPhone és a Mac között, és alkalmazkodik a hálózat minőségéhez. A PTT gomb alapértelmezés szerint jobbra van, de balra helyezhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan layar tetap terenkripsi antara iPhone dan Mac serta menyesuaikan diri dengan kualitas jaringan. Secara default tombol PTT berada di kanan dan dapat dipindahkan ke kiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La visualizzazione dello schermo rimane criptata tra iPhone e Mac e si adatta alla qualità della rete. Il pulsante PTT è a destra per impostazione predefinita e può essere spostato a sinistra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面表示はiPhoneとMacの間で暗号化され、ネットワーク品質に応じて調整されます。PTTボタンは初期設定では右側にあり、左側へ移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 보기는 iPhone과 Mac 사이에서 암호화되며 네트워크 품질에 맞게 조절됩니다. PTT 버튼은 기본적으로 오른쪽에 있으며 왼쪽으로 옮길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparan skrin kekal disulitkan antara iPhone dan Mac serta menyesuaikan diri dengan kualiti rangkaian. Butang PTT berada di sebelah kanan secara lalai dan boleh dialihkan ke kiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermvisningen forblir kryptert mellom iPhone og Mac og tilpasser seg nettverkskvaliteten. PTT-knappen er som standard til høyre, men kan flyttes til venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermweergave blijft versleuteld tussen iPhone en Mac en past zich aan de netwerkkwaliteit aan. De PTT-knop staat standaard rechts en kan naar links worden verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlenie ekranu pozostaje zaszyfrowane między iPhone i Mac i dostosowuje się do jakości sieci. Przycisk PTT jest domyślnie po prawej stronie i można go przenieść w lewo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização da tela permanece criptografada entre o iPhone e o Mac e se adapta à qualidade da rede. O botão PTT fica à direita por padrão e pode ser movido para a esquerda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizualizarea ecranului rămâne criptată între iPhone și Mac și se adaptează calității rețelei. Butonul PTT este implicit în dreapta și poate fi mutat în stânga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр экрана шифруется между iPhone и Mac и подстраивается под качество сети. По умолчанию кнопка PTT находится справа, но её можно переместить влево."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazenie obrazovky zostáva medzi iPhonom a Macom šifrované a prispôsobuje sa kvalite siete. Tlačidlo PTT je predvolene vpravo a možno ho presunúť doľava."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmvisningen förblir krypterad mellan iPhone och Mac och anpassas efter nätverkskvaliteten. PTT-knappen är som standard till höger men kan flyttas till vänster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองหน้าจอยังคงเข้ารหัสระหว่าง iPhone กับ Mac และปรับตามคุณภาพเครือข่าย ปุ่ม PTT อยู่ด้านขวาตามค่าเริ่มต้นและย้ายไปด้านซ้ายได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görünümü iPhone ile Mac arasında şifreli kalır ve ağ kalitesine uyum sağlar. PTT düğmesi varsayılan olarak sağdadır ve sola taşınabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляд екрана залишається зашифрованим між iPhone і Mac та адаптується до якості мережі. Кнопка PTT за замовчуванням розташована праворуч, але її можна перемістити ліворуч."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem màn hình luôn được mã hóa giữa iPhone và Mac, đồng thời thích ứng với chất lượng mạng. Nút PTT mặc định nằm bên phải và có thể chuyển sang trái."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 同 Mac 之間嘅螢幕畫面會保持加密，並按網絡質素自動調整。PTT 按鈕預設喺右邊，亦可以移去左邊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 与 Mac 之间的屏幕视图始终加密，并会适应网络质量。按住说话按钮默认位于右侧，也可移到左侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 與 Mac 之間的螢幕顯示始終加密，並會適應網路品質。按住說話按鈕預設位於右側，也可移到左側。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour écran reste chiffré entre l’iPhone et l’ordinateur et sa qualité s’adapte au réseau. Le bouton PTT est placé à droite par défaut et peut être déplacé à gauche."
          }
        }
      }
    },
