        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह iPhone डिवाइस पर ज़रूरी स्पीच-टू-टेक्स्ट का समर्थन नहीं करता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj iPhone ne podržava potrebnu transkripciju na uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az iPhone nem támogatja a szükséges eszközön történő átírást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini tidak mendukung transkripsi pada perangkat yang diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non supporta la trascrizione richiesta sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneは必要なデバイス上の文字起こしに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 필요한 기기 내 전사를 지원하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini tidak menyokong transkripsi pada peranti yang diperlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen støtter ikke den nødvendige transkriberingen på enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze iPhone ondersteunt de vereiste transcriptie op het apparaat niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten iPhone nie obsługuje wymaganej transkrypcji na urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não suporta a transcrição requerida no dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest iPhone nu acceptă transcrierea necesară pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот iPhone не поддерживает необходимое локальное распознавание речи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento iPhone nepodporuje požadovaný prepis v zariadení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhone-enheten stöder inte den transkribering på enheten som krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone เครื่องนี้ไม่รองรับการถอดเสียงบนอุปกรณ์ที่จำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone, gerekli cihaz içi transkripsiyonu desteklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей iPhone не підтримує потрібне транскрибування на пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone này không hỗ trợ tính năng chép lời trên thiết bị bắt buộc."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部 iPhone 唔支援所需嘅裝置端轉錄。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 不支持所需的设备端转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 不支援所需的裝置端轉寫。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne prend pas en charge la transcription locale requise."
          }
        }
      }
    },
    "ios.this.iphone.was.revoked.pair.it.again.673c52d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone was revoked. Pair it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone wurde widerrufen. Kopple es erneut."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء وصول هذا الـ iPhone. أعد إقرانه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha revocat l’accés d’aquest iPhone. Torna’l a enllaçar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangen for denne iPhone blev tilbagekaldt. Par den igen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup tohoto iPhonu byl odvolán. Spárujte ho znovu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρόσβαση αυτού του iPhone ανακλήθηκε. Συζεύξτε το ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha revocado este iPhone. Vuelve a emparejarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän iPhonen käyttöoikeus peruttiin. Muodosta laitepari uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההרשאה של ה‑iPhone הזה בוטלה. קשרו אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone का ऐक्सेस रद्द कर दिया गया है। इसे फिर पेयर करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovom iPhoneu ukinuta je dozvola. Ponovno ga uparite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az iPhone-nak visszavonták a hozzáférését. Párosítsd újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses iPhone ini telah dicabut. Pasangkan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone è stato revocato. Abbinalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneの承認は取り消されています。もう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 승인이 취소되었습니다. 다시 페어링하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses iPhone ini telah dibatalkan. Pasangkannya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgangen for denne iPhonen ble tilbakekalt. Koble den sammen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toegang voor deze iPhone is ingetrokken. Koppel hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp tego iPhone'a został cofnięty. Sparuj go ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone foi revogado. Emparelhe-o novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul acestui iPhone a fost revocat. Asociază-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ этого iPhone отозван. Свяжите его снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prístup tohto iPhonu bol odvolaný. Spárujte ho znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomsten för denna iPhone har återkallats. Parkoppla den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์ของ iPhone เครื่องนี้ถูกเพิกถอน โปรดจับคู่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'un erişimi kaldırıldı. Yeniden eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ цього iPhone відкликано. Спарте його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập của iPhone này đã bị thu hồi. Hãy ghép đôi lại."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢部 iPhone 嘅權限已撤銷。請重新配對。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
