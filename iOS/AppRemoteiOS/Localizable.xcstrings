    "ios.mac.not.found.check.wi.fi.tailscale.and.that.the.1f73825": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer not found. Check Wi-Fi, Tailscale, and that the companion is open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nicht gefunden. Prüfe WLAN, Tailscale und ob die Begleitapp geöffnet ist."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على Mac. تحقق من Wi‑Fi وTailscale ومن أن التطبيق المصاحب مفتوح."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat el Mac. Comprova la Wi‑Fi, Tailscale i que l’app complementària estigui oberta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac blev ikke fundet. Kontroller wi-fi, Tailscale, og at hjælpeappen er åben."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nebyl nalezen. Zkontrolujte Wi‑Fi, Tailscale a zda je doprovodná aplikace otevřená."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mac δεν βρέθηκε. Ελέγξτε το Wi‑Fi, το Tailscale και ότι η συνοδευτική εφαρμογή είναι ανοιχτή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado el Mac. Comprueba la red Wi-Fi, Tailscale y que la app complementaria esté abierta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macia ei löytynyt. Tarkista Wi‑Fi, Tailscale ja että apuappi on avoinna."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה‑Mac לא נמצא. בדקו את ה‑Wi‑Fi, את Tailscale ושהיישום הנלווה פתוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac नहीं मिला। Wi‑Fi, Tailscale और सहायक ऐप खुला होने की जाँच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nije pronađen. Provjerite Wi‑Fi, Tailscale i je li prateća aplikacija otvorena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mac nem található. Ellenőrizd a Wi‑Fit, a Tailscale-t és hogy nyitva van-e a kísérőalkalmazás."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tidak ditemukan. Periksa Wi-Fi, Tailscale, dan pastikan app pendamping terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac non trovato. Controlla Wi‑Fi, Tailscale e che l’app complementare sia aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macが見つかりません。Wi‑FiとTailscaleを確認し、コンパニオンが開いていることを確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 찾지 못했습니다. Wi‑Fi와 Tailscale을 확인하고 컴패니언이 열려 있는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac tidak ditemui. Periksa Wi‑Fi, Tailscale dan pastikan aplikasi pendamping dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen ble ikke funnet. Kontroller wifi, Tailscale og at hjelpeappen er åpen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac niet gevonden. Controleer wifi, Tailscale en of de hulpapp geopend is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono Maca. Sprawdź Wi-Fi i Tailscale oraz upewnij się, że aplikacja pomocnicza jest otwarta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac não encontrado. Verifique o Wi‑Fi, o Tailscale e se o app complementar está aberto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac-ul nu a fost găsit. Verifică Wi‑Fi, Tailscale și dacă aplicația companion este deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не найден. Проверьте Wi‑Fi, Tailscale и убедитесь, что приложение-компаньон открыто."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac sa nenašiel. Skontrolujte Wi‑Fi, Tailscale a či je sprievodná aplikácia otvorená."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hittades inte. Kontrollera wifi, Tailscale och att hjälpappen är öppen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบ Mac โปรดตรวจสอบ Wi‑Fi, Tailscale และตรวจว่าแอปคู่หูเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bulunamadı. Wi-Fi ve Tailscale bağlantısını kontrol edin, ardından yardımcı uygulamanın açık olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не знайдено. Перевірте Wi‑Fi, Tailscale і чи відкрита програма-компаньйон."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy Mac. Hãy kiểm tra Wi-Fi, Tailscale và bảo đảm ứng dụng đồng hành đang mở."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "搵唔到 Mac。請檢查 Wi‑Fi、Tailscale，同埋輔助 App 係咪已開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 Mac。请检查 Wi‑Fi、Tailscale，并确认配套 App 已打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 Mac。請檢查 Wi‑Fi、Tailscale，並確認輔助 App 已開啟。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinateur introuvable. Vérifiez le Wi‑Fi, Tailscale et que le compagnon est ouvert."
          }
        }
      }
    },
