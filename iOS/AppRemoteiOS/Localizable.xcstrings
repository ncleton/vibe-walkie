    "ios.control.the.pointer.keyboard.and.dictation.from.this.iphone.no.2d4c813": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control the pointer, keyboard, and dictation from this iPhone. No account, no cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere Zeiger, Tastatur und Diktat von diesem iPhone aus. Kein Konto, keine Cloud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكّم في المؤشر ولوحة المفاتيح والإملاء من هذا الـ iPhone. بلا حساب ولا خدمة سحابية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla el punter, el teclat i el dictat des d’aquest iPhone. Sense compte ni núvol."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr markøren, tastaturet og dikteringen fra denne iPhone. Ingen konto, ingen sky."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládejte ukazatel, klávesnici a diktování z tohoto iPhonu. Bez účtu a bez cloudu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τον δείκτη, το πληκτρολόγιο και την υπαγόρευση από αυτό το iPhone. Χωρίς λογαριασμό και χωρίς cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla el puntero, el teclado y el dictado desde este iPhone. Sin cuenta ni nube."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohjaa osoitinta, näppäimistöä ja sanelua tästä iPhonesta. Ei tiliä eikä pilvipalvelua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלטו במצביע, במקלדת ובהכתבה מה‑iPhone הזה. ללא חשבון וללא ענן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone से पॉइंटर, कीबोर्ड और डिक्टेशन नियंत्रित करें। न अकाउंट, न क्लाउड।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravljajte pokazivačem, tipkovnicom i diktiranjem s ovog iPhonea. Bez računa i bez oblaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezéreld a mutatót, a billentyűzetet és a diktálást erről az iPhone-ról. Nincs fiók, nincs felhő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendalikan penunjuk, papan ketik, dan dikte dari iPhone ini. Tanpa akun, tanpa cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il puntatore, la tastiera e la dettatura da questo iPhone. Nessun account e nessun cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneからポインタ、キーボード、音声入力を操作できます。アカウントもクラウドも不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 포인터, 키보드, 받아쓰기를 제어하세요. 계정도 클라우드도 필요 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawal penuding, papan kekunci dan imlak daripada iPhone ini. Tanpa akaun dan tanpa awan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr pekeren, tastaturet og dikteringen fra denne iPhonen. Ingen konto, ingen sky."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedien de aanwijzer, het toetsenbord en dicteren vanaf deze iPhone. Geen account, geen cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steruj wskaźnikiem, klawiaturą i dyktowaniem z tego iPhone’a. Bez konta i bez chmury."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle o ponteiro, o teclado e o ditado a partir deste iPhone. Sem conta e sem nuvem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlează cursorul, tastatura și dictarea de pe acest iPhone. Fără cont și fără cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте указателем, клавиатурой и диктовкой с этого iPhone. Без учётной записи и облака."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovládajte ukazovateľ, klávesnicu a diktovanie z tohto iPhonu. Bez účtu a bez cloudu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr pekaren, tangentbordet och dikteringen från denna iPhone. Inget konto, inget moln."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมตัวชี้ แป้นพิมพ์ และการป้อนตามคำบอกจาก iPhone เครื่องนี้ โดยไม่ต้องมีบัญชีหรือคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşaretçiyi, klavyeyi ve dikteyi bu iPhone’dan denetleyin. Hesap yok, bulut yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте вказівником, клавіатурою та диктуванням із цього iPhone. Без облікового запису й хмари."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển con trỏ, bàn phím và đọc chính tả từ iPhone này. Không tài khoản, không đám mây."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "用呢部 iPhone 控制游標、鍵盤同聽寫。唔使帳戶，唔經雲端。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过这台 iPhone 控制指针、键盘和听写。无需账户，也无需云服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過這台 iPhone 控制指標、鍵盤和聽寫。無需帳號，也無需雲端服務。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre ordinateur, ouvrez votre navigateur et tapez :"
          }
        }
      }
    },
