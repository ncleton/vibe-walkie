        }
      }
    },
    "ios.this.tour.is.read.only.no.command.is.sent.and.cb7442d": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tour is read-only. No command is sent and no computer is shown as connected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einführung ist schreibgeschützt. Es wird kein Befehl gesendet und kein Mac als verbunden angezeigt."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الجولة للعرض فقط. لا يتم إرسال أي أمر ولا يظهر أي Mac على أنه متصل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta visita és només de lectura. No s’envia cap ordre i no es mostra cap Mac com a connectat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rundvisning er skrivebeskyttet. Ingen kommandoer sendes, og ingen Mac vises som forbundet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato prohlídka je jen pro čtení. Neodesílají se žádné příkazy a žádný Mac se nezobrazuje jako připojený."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η περιήγηση είναι μόνο για ανάγνωση. Δεν αποστέλλεται καμία εντολή και κανένα Mac δεν εμφανίζεται ως συνδεδεμένο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recorrido es de solo lectura. No se envía ningún comando ni se muestra ningún Mac como conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä esittely on vain luku -tilassa. Komentoja ei lähetetä eikä yhtään Macia näytetä yhdistettynä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיור הזה הוא לקריאה בלבד. שום פקודה אינה נשלחת ואף Mac אינו מוצג כמחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टूर केवल देखने के लिए है। कोई कमांड नहीं भेजा जाता और कोई Mac कनेक्टेड नहीं दिखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj je obilazak samo za čitanje. Nijedna se naredba ne šalje i nijedan se Mac ne prikazuje kao povezan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a bemutató csak olvasható. Nem küld parancsot, és egy Mac sem jelenik meg csatlakoztatottként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur ini hanya dapat dilihat. Tidak ada perintah yang dikirim dan tidak ada Mac yang ditampilkan sebagai terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa panoramica è in sola lettura. Non viene inviato alcun comando e nessun Mac appare come connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツアーは閲覧専用です。コマンドは送信されず、Macが接続済みとして表示されることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 둘러보기는 읽기 전용입니다. 명령은 전송되지 않으며 Mac이 연결된 것으로 표시되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawatan ini adalah baca sahaja. Tiada perintah dihantar dan tiada Mac dipaparkan sebagai bersambung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne omvisningen er skrivebeskyttet. Ingen kommandoer sendes, og ingen Mac vises som tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze rondleiding is alleen-lezen. Er worden geen commando's verstuurd en geen Mac wordt als verbonden getoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prezentacja jest tylko do odczytu. Żadne polecenie nie jest wysyłane i żaden Mac nie jest wyświetlany jako połączony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tour é somente leitura. Nenhum comando é enviado e nenhum Mac aparece como conectado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest tur este doar pentru citire. Nu se trimite nicio comandă și niciun Mac nu apare ca fiind conectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот обзор доступен только для просмотра. Команды не отправляются, а Mac не показывается подключённым."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto prehliadka je iba na čítanie. Neodosielajú sa žiadne príkazy a žiadny Mac sa nezobrazuje ako pripojený."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här rundturen är skrivskyddad. Inga kommandon skickas och ingen Mac visas som ansluten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสาธิตนี้เป็นแบบอ่านอย่างเดียว ไม่มีการส่งคำสั่งและไม่มี Mac แสดงว่าเชื่อมต่ออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tur salt okunurdur. Hiçbir komut gönderilmez ve hiçbir Mac bağlı olarak gösterilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей огляд доступний лише для читання. Команди не надсилаються, а жоден Mac не відображається як підключений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyến tham quan này chỉ để xem. Không có lệnh nào được gửi và không có Mac nào hiển thị là đã kết nối."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個導覽只供閱讀。唔會傳送指令，亦唔會顯示任何 Mac 已連接。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此导览为只读模式。不会发送任何命令，也不会显示 Mac 已连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此導覽為只讀模式。不會傳送任何命令，也不會顯示 Mac 已連線。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette visite est en lecture seule. Aucune commande n’est envoyée et aucun ordinateur n’est simulé comme connecté."
          }
        }
      }
    },
    "ios.this.window.is.on.another.desktop.open.it.once.on.53b6079": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window is on another desktop. Open it once on the computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fenster befindet sich auf einem anderen Schreibtisch. Öffne es einmal auf dem Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النافذة على سطح مكتب آخر. افتحها مرة واحدة على Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta finestra és en un altre escriptori. Obre-la una vegada al Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vindue er på et andet skrivebord. Åbn det én gang på Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto okno je na jiné ploše. Jednou ho otevřete na Macu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το παράθυρο βρίσκεται σε άλλη επιφάνεια εργασίας. Ανοίξτε το μία φορά στο Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana está en otro escritorio. Ábrela una vez en el Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ikkuna on toisella työpöydällä. Avaa se kerran Macissa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלון הזה נמצא בשולחן עבודה אחר. פתחו אותו פעם אחת ב‑Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह विंडो दूसरे डेस्कटॉप पर है। इसे Mac पर एक बार खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj je prozor na drugoj radnoj površini. Jednom ga otvorite na Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az ablak egy másik íróasztalon van. Nyisd meg egyszer a Macen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela ini ada di desktop lain. Buka sekali di Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra si trova su un’altra scrivania. Aprila una volta sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウは別のデスクトップにあります。Macで一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 윈도우는 다른 데스크탑에 있습니다. Mac에서 한 번 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap ini berada pada desktop lain. Bukanya sekali pada Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vinduet er på et annet skrivebord. Åpne det én gang på Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit venster staat op een ander bureaublad. Open het eenmaal op de Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To okno znajduje się na innym biurku. Otwórz je raz na Macu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela está em outra Mesa. Abra-a uma vez no Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această fereastră se află pe alt desktop. Deschide-o o dată pe Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно находится на другом рабочем столе. Откройте его один раз на Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto okno je na inej ploche. Raz ho otvorte na Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här fönstret finns på ett annat skrivbord. Öppna det en gång på Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่างนี้อยู่บนเดสก์ท็อปอื่น โปรดเปิดบน Mac หนึ่งครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencere başka bir masaüstünde. Mac'te bir kez açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це вікно розташоване на іншому робочому столі. Один раз відкрийте його на Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ này nằm trên một màn hình nền khác. Hãy mở một lần trên Mac."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個視窗喺另一個桌面。請先喺 Mac 開啟一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
