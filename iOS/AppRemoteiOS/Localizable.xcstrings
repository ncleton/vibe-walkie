    "ios.too.many.commands.were.sent.slow.down.6850b10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many commands were sent. Slow down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Befehle wurden gesendet. Bitte langsamer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال أوامر كثيرة جداً. تمهّل قليلاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’han enviat massa ordres. Ves més a poc a poc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev sendt for mange kommandoer. Sæt tempoet ned."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo odesláno příliš mnoho příkazů. Zpomalte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στάλθηκαν πάρα πολλές εντολές. Επιβραδύνετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han enviado demasiados comandos. Ve más despacio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentoja lähetettiin liian monta. Hidasta tahtia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלחו יותר מדי פקודות. האטו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा कमांड भेजे गए। थोड़ा रुकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslano je previše naredbi. Usporite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok parancs lett elküldve. Lassíts."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak perintah yang dikirim. Perlambat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono stati inviati troppi comandi. Rallenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの送信が多すぎます。少し待ってから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 많은 명령을 보냈습니다. 잠시 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak perintah dihantar. Perlahankan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange kommandoer ble sendt. Senk tempoet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn te veel commando's verstuurd. Doe het rustiger aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłano zbyt wiele poleceń. Zwolnij."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comandos demais foram enviados. Reduza o ritmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Au fost trimise prea multe comenzi. Încetinește."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено слишком много команд. Немного подождите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odoslalo sa priveľa príkazov. Spomaľte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många kommandon skickades. Sakta ner."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำสั่งมากเกินไป โปรดช้าลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla komut gönderildi. Yavaşlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслано забагато команд. Трохи зачекайте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi quá nhiều lệnh. Hãy chậm lại."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送咗太多指令。請慢少少。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送的命令过多。请降低操作速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送的命令過多。請降低操作速度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de commandes envoyées, ralentissez."
          }
        }
      }
    },
