    "ios.delivery.not.confirmed.check.the.active.field.e0e5a15": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery not confirmed. Check the active field."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügen nicht bestätigt. Prüfe das aktive Feld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد إدخال النص. تحقق من الحقل النشط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha confirmat la inserció. Comprova el camp actiu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsættelsen blev ikke bekræftet. Kontroller det aktive felt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložení nebylo potvrzeno. Zkontrolujte aktivní pole."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εισαγωγή δεν επιβεβαιώθηκε. Ελέγξτε το ενεργό πεδίο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha confirmado la inserción. Comprueba el campo activo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstin syöttämistä ei vahvistettu. Tarkista aktiivinen kenttä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזנת הטקסט לא אושרה. בדקו את השדה הפעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट डालने की पुष्टि नहीं हुई। सक्रिय फ़ील्ड जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umetanje nije potvrđeno. Provjerite aktivno polje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszúrás nincs megerősítve. Ellenőrizd az aktív mezőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyisipan belum dikonfirmasi. Periksa kolom aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserimento non confermato. Controlla il campo attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの入力を確認できませんでした。使用中のフィールドを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 입력을 확인하지 못했습니다. 활성 필드를 확인하세요."
          }
        },
        "ms": {
