        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업하는 동안 걸은 걸음 수입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah-langkah yang anda ambil semasa bekerja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trinnene du tar mens du jobber."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stappen die je zet tijdens het werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroki, które wykonujesz podczas pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os passos que você dá enquanto trabalha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pașii pe care îi faci în timp ce lucrezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги, которые вы предпринимаете во время работы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroky, ktoré robíte pri práci."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegen du tar när du arbetar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนก้าวที่คุณเดินขณะทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışırken attığınız adımlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кроки, які ви робите під час роботи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước bạn thực hiện khi làm việc."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "你喺工作時行嘅步數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作时走过的步数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作時走過的步數。"
          }
        }
      }
    },
    "ios.health.hero.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera detects when you walk in front of your Mac. Your iPhone uses Apple Health to count only the steps taken during those periods."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra détecte quand vous marchez devant votre Mac. L’iPhone utilise Apple Santé pour compter uniquement les pas effectués pendant ces périodes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكتشف الكاميرا عندما تمشي أمام Mac. يستخدم iPhone تطبيق Apple Health لاحتساب الخطوات التي تقطعها خلال تلك الفترات فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan Vibe Walkie està actiu i connectat al Mac, l’iPhone utilitza Apple Health per comptar els passos fets durant aquesta sessió de treball."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je Vibe Walkie aktivní a připojené k Macu, iPhone pomocí Apple Health počítá kroky během této pracovní relace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Vibe Walkie er aktiv og forbundet til din Mac, bruger din iPhone Apple Health til at tælle skridtene under arbejdssessionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Vibe Walkie aktiv und mit deinem Mac verbunden ist, zählt dein iPhone über Apple Health die Schritte während dieser Arbeitssitzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το Vibe Walkie είναι ενεργό και συνδεδεμένο στο Mac, το iPhone χρησιμοποιεί το Apple Health για να μετρά τα βήματα αυτής της περιόδου εργασίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Vibe Walkie está activo y conectado al Mac, el iPhone usa Apple Health para contar los pasos dados durante esa sesión de trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Vibe Walkie on aktiivinen ja yhdistetty Maciin, iPhone laskee Apple Healthin avulla työskentelyjakson aikana otetut askeleet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה מזהה כשאתם הולכים מול ה‑Mac. ה‑iPhone משתמש ב‑Apple Health כדי לספור רק את הצעדים שביצעתם בזמנים האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Vibe Walkie सक्रिय और आपके Mac से कनेक्ट हो, तो iPhone Apple Health से उस कार्य सत्र के दौरान चले गए कदम गिनता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je Vibe Walkie aktivan i povezan s Macom, iPhone putem aplikacije Apple Health broji korake tijekom te radne sesije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor a Vibe Walkie aktív és csatlakozik a Machez, az iPhone az Apple Health segítségével számolja a munkamenet során megtett lépéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Vibe Walkie aktif dan terhubung ke Mac, iPhone menggunakan Apple Health untuk menghitung langkah selama sesi kerja tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando Vibe Walkie è attiva e connessa al Mac, l’iPhone usa Apple Health per contare i passi effettuati durante la sessione di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの前を歩いている時間をカメラが検出し、その時間の歩数だけをiPhoneのApple Healthから集計します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie가 활성 상태로 Mac에 연결되어 있으면 iPhone이 Apple Health를 사용해 해당 작업 세션 동안의 걸음 수를 계산합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila Vibe Walkie aktif dan bersambung ke Mac, iPhone menggunakan Apple Health untuk mengira langkah semasa sesi kerja tersebut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når Vibe Walkie er aktiv og koblet til Macen, bruker iPhone Apple Health til å telle skrittene i arbeidsøkten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer Vibe Walkie actief en verbonden is met je Mac, gebruikt de iPhone Apple Health om de stappen tijdens die werksessie te tellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy Vibe Walkie jest aktywne i połączone z Makiem, iPhone używa Apple Health do liczenia kroków podczas tej sesji pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera detecta quando você passa na frente do seu Mac. Seu iPhone usa Apple Health para contar apenas os passos dados durante esses períodos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când Vibe Walkie este activ și conectat la Mac, iPhone folosește Apple Health pentru a număra pașii din timpul acelei sesiuni de lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда Vibe Walkie активно и подключено к Mac, iPhone использует Apple Health для подсчёта шагов во время рабочего сеанса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď je Vibe Walkie aktívne a pripojené k Macu, iPhone pomocou Apple Health počíta kroky počas tejto pracovnej relácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När Vibe Walkie är aktiv och ansluten till din Mac använder iPhone Apple Health för att räkna stegen under arbetspasset."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องจะตรวจจับเมื่อคุณเดินอยู่หน้า Mac โดย iPhone จะใช้ Apple Health เพื่อนับเฉพาะจำนวนก้าวที่เดินในช่วงเวลาดังกล่าว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibe Walkie etkin ve Mac’inize bağlıyken iPhone, çalışma oturumu sırasında atılan adımları Apple Health ile sayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли Vibe Walkie активна й підключена до Mac, iPhone використовує Apple Health для підрахунку кроків під час робочого сеансу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Vibe Walkie đang hoạt động và kết nối với Mac, iPhone dùng Apple Health để đếm số bước trong phiên làm việc đó."
          }
        },
        "yue": {
          "stringUnit": {
            "state": "translated",
            "value": "當你喺 Mac 前面行路時，相機會偵測到。iPhone 會使用 Apple Health，只計算呢啲時段內行嘅步數。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头会检测你在Mac前走路的时段，iPhone仅通过Apple Health统计这些时段内的步数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機會偵測你在Mac前走路的時段，iPhone只會透過Apple Health統計這些時段內的步數。"
          }
        }
      }
    },
